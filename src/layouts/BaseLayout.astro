---
import "../styles/global.css";
import {
    getLangFromUrl,
    useTranslations,
    useTranslatedPath,
    getRouteFromUrl,
    languages,
    defaultLang,
} from "../i18n/ui";
import { normalizeBaseUrl } from "../utils/images";

export interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Marc Ravelontsalama | Embedded Systems Engineer",
    description = "Embedded systems, firmware, electronics, PCB design, and control engineering projects by Marc Ravelontsalama.",
} = Astro.props;
const baseUrl = normalizeBaseUrl(import.meta.env.BASE_URL);
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const route = getRouteFromUrl(Astro.url);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL(`${baseUrl}social-preview.png?v=2`, Astro.site);
const localizedUrl = (locale: "en" | "fr" | "tr") => {
    const path = translatePath(route, locale);
    return new URL(path.endsWith("/") ? path : `${path}/`, Astro.site);
};
const localeUrls = {
    en: localizedUrl("en"),
    fr: localizedUrl("fr"),
    tr: localizedUrl("tr"),
};
const internshipStatus = {
    en: { line1: "Open to", line2: "internship" },
    fr: { line1: "Ouvert aux", line2: "stages" },
    tr: { line1: "Staj için", line2: "müsait" },
}[lang];

const navItems = [
    { path: "/", label: t("nav.home"), active: route === "/" },
    { path: "/about", label: t("nav.about"), active: route.includes("/about") },
    { path: "/projects", label: t("nav.projects"), active: route.includes("/projects") },
    { path: "/contacts", label: t("nav.contact"), active: route.includes("/contacts") },
];
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Roboto+Mono:ital,wght@0,400..700;1,400..700&family=Inter:wght@400;500;600;700;800&display=swap"
        />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalUrl} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={socialImageUrl} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1343" />
        <meta property="og:image:height" content="762" />
        <meta property="og:locale" content={`${lang}_${lang === "en" ? "US" : lang === "fr" ? "FR" : "TR"}`} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImageUrl} />
        {Object.entries(localeUrls).map(([locale, url]) => (
            <link rel="alternate" hreflang={locale} href={url} />
        ))}
        <link rel="alternate" hreflang="x-default" href={localeUrls.en} />

        <!-- Favicon -->
        <link
            rel="icon"
            type="image/svg+xml"
            href={`${baseUrl}favicon.svg`}
        />

        <!-- Client-side Routing and Language Auto-Detection -->
        <script define:vars={{ baseUrl, defaultLang, supportedLangs: Object.keys(languages) }}>
            (function () {
                try {
                    const storedLang = localStorage.getItem("preferredLang");
                    const browserLang = navigator.language.split("-")[0];
                    const basePath = baseUrl === "/" ? "" : baseUrl.replace(/\/$/, "");

                    const currentPath = window.location.pathname;
                    let pathWithoutBase =
                        currentPath.replace(basePath, "") || "/";
                    if (!pathWithoutBase.startsWith("/"))
                        pathWithoutBase = "/" + pathWithoutBase;

                    const currentDocLang =
                        supportedLangs.find(
                            (l) =>
                                pathWithoutBase.startsWith(`/${l}/`) ||
                                pathWithoutBase === `/${l}`,
                        ) || defaultLang;

                    if (!storedLang) {
                        const targetLang = supportedLangs.includes(browserLang)
                            ? browserLang
                            : defaultLang;
                        if (
                            targetLang !== defaultLang &&
                            currentDocLang === defaultLang &&
                            (pathWithoutBase === "/" || pathWithoutBase === "")
                        ) {
                            localStorage.setItem("preferredLang", targetLang);
                            window.location.replace(
                                basePath + "/" + targetLang + "/",
                            );
                        }
                    }
                } catch (error) {
                    console.warn("Unable to determine the preferred language.", error);
                }
            })();
        </script>
    </head>

    <body class="d-flex flex-column">
        <!-- Sentinel for scroll tracking -->
        <div id="navSentinel" aria-hidden="true"></div>

        <!-- ===================== NAVBAR ===================== -->
        <header class:list={["navbar-wrapper", { "navbar-home": route === "/" }]}>
            <div class="container navbar-container">
                <!-- Brand and internship status on the left -->
                <div class="navbar-brand-group">
                    <a class="navbar-brand" href={translatePath("/")} aria-label="Marc — Home">
                        Marc
                    </a>
                    <div class="brand-divider" aria-hidden="true"></div>
                    <div class="brand-subtext" aria-label={`${internshipStatus.line1} ${internshipStatus.line2}`}>
                        <span class="brand-subtext-line1">{internshipStatus.line1}</span>
                        <span class="brand-subtext-line2">{internshipStatus.line2}</span>
                    </div>
                </div>

                <!-- Right Section: Menu (Desktop) + Language Selector + Hamburger (Mobile) -->
                <div class="navbar-right">
                    <!-- Desktop Menu (on the right on big screen) -->
                    <nav class="desktop-nav d-none d-lg-flex" aria-label="Main menu">
                        <ul class="nav-links">
                            {
                                navItems.map((item) => (
                                    <li>
                                        <a
                                            class:list={["nav-link", { active: item.active }]}
                                            href={translatePath(item.path)}
                                            aria-current={item.active ? "page" : undefined}
                                        >
                                            {item.label}
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </nav>

                    <!-- Language Selector (next to menu on desktop, next to collapse on mobile) -->
                    <div class="lang-wrapper">
                        <button
                            id="langToggle"
                            class="nav-btn lang-toggle"
                            type="button"
                            aria-expanded="false"
                            aria-controls="langMenu"
                            aria-haspopup="true"
                            aria-label={`Language: ${languages[lang]}`}
                        >
                            <span class:list={["lang-flag", `lang-flag--${lang}`]} aria-hidden="true"></span>
                            <span class="lang-code">{lang.toUpperCase()}</span>
                            <svg class="dropdown-chevron" aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        <div id="langMenu" class="lang-dropdown" hidden role="menu" aria-label="Language options">
                            {
                                Object.entries(languages).map(([code, name]) => (
                                    <a
                                        class:list={["lang-option", { active: code === lang }]}
                                        href={translatePath(route, code as keyof typeof languages)}
                                        data-lang={code}
                                        role="menuitem"
                                    >
                                        <span class:list={["lang-flag", `lang-flag--${code}`]} aria-hidden="true"></span>
                                        <span class="lang-name">{name}</span>
                                    </a>
                                ))
                            }
                        </div>
                    </div>

                    <!-- Collapse Menu Toggle Button (on the right on mobile) -->
                    <button
                        id="mobileMenuToggle"
                        class="nav-btn menu-toggle d-lg-none"
                        type="button"
                        aria-label="Toggle navigation menu"
                        aria-expanded="false"
                        aria-controls="mobileMenu"
                    >
                        <svg class="hamburger-icon" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <line class="line-top" x1="4" x2="20" y1="6" y2="6"></line>
                            <line class="line-mid" x1="4" x2="20" y1="12" y2="12"></line>
                            <line class="line-bot" x1="4" x2="20" y1="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Mobile Collapse Menu (on the right on mobile) -->
            <div id="mobileMenu" class="mobile-collapse-menu d-lg-none" hidden aria-label="Mobile navigation">
                <nav class="mobile-menu-inner">
                    {
                        navItems.map((item) => (
                            <a
                                class:list={["mobile-nav-link", { active: item.active }]}
                                href={translatePath(item.path)}
                                aria-current={item.active ? "page" : undefined}
                            >
                                {item.label}
                            </a>
                        ))
                    }
                </nav>
            </div>
        </header>

        <main class="flex-grow-1">
            <slot />
        </main>

        <!-- ===================== FOOTER ===================== -->
        <footer class="site-footer py-5 mt-auto">
            <div class="container text-center small">
                <div class="mb-3 footer-copyright">
                    © <span id="currentYear"></span> Marc — Engineering Portfolio
                </div>
                <div class="d-flex justify-content-center flex-wrap gap-3 footer-links">
                    <a
                        href="https://github.com/marcravel"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="footer-link"
                    >
                        {t("footer.github")}
                    </a>
                    <a
                        href="https://www.linkedin.com/in/marc-anjaniaina-ravelontsalama/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="footer-link"
                    >
                        {t("footer.linkedin")}
                    </a>
                    <a
                        href={translatePath("/contacts")}
                        class="footer-link"
                    >
                        {t("footer.contact")}
                    </a>
                </div>
            </div>
        </footer>

        <style>
            #navSentinel {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 1px;
                pointer-events: none;
                visibility: hidden;
            }

            .lang-flag {
                position: relative;
                display: inline-block;
                width: 22px;
                height: 15px;
                overflow: hidden;
                flex: 0 0 auto;
                border: 1px solid rgb(255 255 255 / 0.6);
                border-radius: 2px;
                box-shadow: 0 1px 0 rgb(0 0 0 / 0.25);
                vertical-align: middle;
            }

            .lang-flag--en {
                background:
                    linear-gradient(33deg, transparent 43%, #fff 43% 48%, #c8102e 48% 52%, #fff 52% 57%, transparent 57%),
                    linear-gradient(-33deg, transparent 43%, #fff 43% 48%, #c8102e 48% 52%, #fff 52% 57%, transparent 57%),
                    linear-gradient(90deg, transparent 42%, #fff 42% 58%, transparent 58%),
                    linear-gradient(0deg, transparent 40%, #fff 40% 60%, transparent 60%),
                    linear-gradient(90deg, transparent 46%, #c8102e 46% 54%, transparent 54%),
                    linear-gradient(0deg, transparent 44%, #c8102e 44% 56%, transparent 56%),
                    #012169;
            }

            .lang-flag--fr {
                background: linear-gradient(90deg, #0055a4 0 33.33%, #fff 33.33% 66.66%, #ef4135 66.66%);
            }

            .lang-flag--tr {
                background: #e30a17;
            }

            .lang-flag--tr::before {
                position: absolute;
                top: 3px;
                left: 5px;
                width: 9px;
                height: 9px;
                border-radius: 50%;
                background: #fff;
                content: "";
            }

            .lang-flag--tr::after {
                position: absolute;
                top: 3px;
                left: 8px;
                width: 9px;
                height: 9px;
                border-radius: 50%;
                background: #e30a17;
                content: "";
            }

            .lang-code {
                letter-spacing: 0.05em;
            }

            .dropdown-chevron {
                transition: transform 160ms var(--spring);
            }

            .lang-toggle[aria-expanded="true"] .dropdown-chevron {
                transform: rotate(180deg);
            }

            .menu-toggle {
                padding: 8px;
            }

            .hamburger-icon {
                display: block;
            }

            .hamburger-icon line {
                transition: transform 200ms var(--ease), opacity 200ms var(--ease);
                transform-origin: center;
            }

            .menu-toggle[aria-expanded="true"] .line-top {
                transform: translateY(6px) rotate(45deg);
            }

            .menu-toggle[aria-expanded="true"] .line-mid {
                opacity: 0;
            }

            .menu-toggle[aria-expanded="true"] .line-bot {
                transform: translateY(-6px) rotate(-45deg);
            }

            .mobile-menu-inner {
                display: flex;
                flex-direction: column;
                gap: 4px;
            }
        </style>

        <!-- ===================== SCRIPTS ===================== -->
        <script is:inline>
            document.addEventListener("DOMContentLoaded", () => {
                const year = document.getElementById("currentYear");
                if (year) year.textContent = new Date().getFullYear();

                const header = document.querySelector(".navbar-wrapper");
                if (!header) return;

                // Mobile collapse menu and language dropdown controls
                const menuBtn = document.getElementById("mobileMenuToggle");
                const menu = document.getElementById("mobileMenu");
                const langBtn = document.getElementById("langToggle");
                const langMenu = document.getElementById("langMenu");
                const langWrapper = document.querySelector(".lang-wrapper");

                const setOpen = (panel, button, open) => {
                    if (!panel || !button) return;
                    panel.hidden = !open;
                    button.setAttribute("aria-expanded", String(open));
                };

                const closeLang = () => setOpen(langMenu, langBtn, false);
                const closeMenu = () => {
                    setOpen(menu, menuBtn, false);
                    header.classList.remove("menu-open");
                };

                // Hamburger toggle
                menuBtn?.addEventListener("click", (e) => {
                    e.stopPropagation();
                    const open = menu.hidden;
                    closeLang();
                    setOpen(menu, menuBtn, open);
                    header.classList.toggle("menu-open", open);
                });

                menu?.addEventListener("click", (e) => {
                    if (e.target.closest("a")) closeMenu();
                });

                // Language dropdown toggle
                langBtn?.addEventListener("click", (e) => {
                    e.stopPropagation();
                    const open = langMenu.hidden;
                    closeMenu();
                    setOpen(langMenu, langBtn, open);
                });

                langMenu?.addEventListener("click", (e) => {
                    const link = e.target.closest("a[data-lang]");
                    if (!link) return;
                    try {
                        localStorage.setItem("preferredLang", link.dataset.lang);
                    } catch {}
                });

                // Click outside to close
                document.addEventListener("click", (e) => {
                    if (!langWrapper?.contains(e.target)) closeLang();
                    if (!menu?.contains(e.target) && !menuBtn?.contains(e.target)) closeMenu();
                });

                // Escape key to close
                document.addEventListener("keydown", (e) => {
                    if (e.key === "Escape") {
                        closeLang();
                        closeMenu();
                    }
                });

                // Close mobile menu on desktop resize
                window.addEventListener("resize", () => {
                    if (window.innerWidth >= 992) {
                        closeMenu();
                    }
                });
            });
        </script>
    </body>
</html>
