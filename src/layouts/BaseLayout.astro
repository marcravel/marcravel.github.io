---
import "../styles/global.css";
import {
    getLangFromUrl,
    useTranslations,
    useTranslatedPath,
    getRouteFromUrl,
    languages,
    flags,
} from "../i18n/ui";

export interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Marc Ravelontsalama | Embedded Systems Engineer",
    description = "Embedded systems, firmware, electronics, PCB design and control projects by Marc Ravelontsalama.",
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const route = getRouteFromUrl(Astro.url);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL(`${baseUrl}social-preview.jpg`, Astro.site);
const localizedUrl = (locale: "en" | "fr" | "tr") => {
    const path = translatePath(route, locale);
    return new URL(path.endsWith("/") ? path : `${path}/`, Astro.site);
};
const localeUrls = {
    en: localizedUrl("en"),
    fr: localizedUrl("fr"),
    tr: localizedUrl("tr"),
};

const navItems = [
    { path: "/", label: t("nav.home"), active: route === "/" },
    { path: "/about", label: t("nav.about"), active: route.includes("/about") },
    { path: "/projects", label: t("nav.projects"), active: route.includes("/projects") },
    { path: "/contacts", label: t("nav.contact"), active: route.includes("/contacts") },
];
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalUrl} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={socialImageUrl} />
        <meta property="og:locale" content={`${lang}_${lang === "en" ? "US" : lang === "fr" ? "FR" : "TR"}`} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImageUrl} />
        {Object.entries(localeUrls).map(([locale, url]) => (
            <link rel="alternate" hreflang={locale} href={url} />
        ))}
        <link rel="alternate" hreflang="x-default" href={localeUrls.en} />

        <!-- Favicon -->
        <link
            rel="icon"
            type="image/svg+xml"
            href={`${baseUrl}favicon.svg`}
        />

        <!-- Client-side Routing and Language Auto-Detection -->
        <script define:vars={{ baseUrl }}>
            (function () {
                try {
                    const storedLang = localStorage.getItem("preferredLang");
                    const browserLang = navigator.language.split("-")[0];
                    const supportedLangs = ["en", "fr", "tr"];
                    const defaultLang = "en";
                    const basePath = baseUrl === "/" ? "" : baseUrl.replace(/\/$/, "");

                    const currentPath = window.location.pathname;
                    let pathWithoutBase =
                        currentPath.replace(basePath, "") || "/";
                    if (!pathWithoutBase.startsWith("/"))
                        pathWithoutBase = "/" + pathWithoutBase;

                    const currentDocLang =
                        supportedLangs.find(
                            (l) =>
                                pathWithoutBase.startsWith(`/${l}/`) ||
                                pathWithoutBase === `/${l}`,
                        ) || defaultLang;

                    if (!storedLang) {
                        const targetLang = supportedLangs.includes(browserLang)
                            ? browserLang
                            : defaultLang;
                        if (
                            targetLang !== defaultLang &&
                            currentDocLang === defaultLang &&
                            (pathWithoutBase === "/" || pathWithoutBase === "")
                        ) {
                            localStorage.setItem("preferredLang", targetLang);
                            window.location.replace(
                                basePath + "/" + targetLang + "/",
                            );
                        }
                    }
                } catch (error) {
                    console.warn("Unable to determine the preferred language.", error);
                }
            })();
        </script>
    </head>

    <body class="d-flex flex-column">
        <!-- Sentinel for scroll tracking -->
        <div id="navSentinel" aria-hidden="true"></div>

        <!-- ===================== NAVBAR ===================== -->
        <header class:list={["navbar-wrapper", { "navbar-home": route === "/" }]}>
            <div class="container navbar-container">
                <!-- Brand on Left -->
                <a class="navbar-brand" href={translatePath("/")} aria-label="Marc — Home">
                    Marc
                </a>

                <!-- Right Section: Menu (Desktop) + Language Selector + Hamburger (Mobile) -->
                <div class="navbar-right">
                    <!-- Desktop Menu (on the right on big screen) -->
                    <nav class="desktop-nav d-none d-lg-flex" aria-label="Main menu">
                        <ul class="nav-links">
                            {
                                navItems.map((item) => (
                                    <li>
                                        <a
                                            class:list={["nav-link", { active: item.active }]}
                                            href={translatePath(item.path)}
                                            aria-current={item.active ? "page" : undefined}
                                        >
                                            {item.label}
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </nav>

                    <!-- Language Selector (next to menu on desktop, next to collapse on mobile) -->
                    <div class="lang-wrapper">
                        <button
                            id="langToggle"
                            class="nav-btn lang-toggle"
                            type="button"
                            aria-expanded="false"
                            aria-controls="langMenu"
                            aria-haspopup="true"
                            aria-label={`Language: ${languages[lang]}`}
                        >
                            <span class="lang-flag" aria-hidden="true">{flags[lang]}</span>
                            <span class="lang-code">{lang.toUpperCase()}</span>
                            <svg class="dropdown-chevron" aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        <div id="langMenu" class="lang-dropdown" hidden role="menu" aria-label="Language options">
                            {
                                Object.entries(languages).map(([code, name]) => (
                                    <a
                                        class:list={["lang-option", { active: code === lang }]}
                                        href={translatePath(route, code as keyof typeof languages)}
                                        data-lang={code}
                                        role="menuitem"
                                    >
                                        <span class="lang-flag" aria-hidden="true">{flags[code as keyof typeof languages]}</span>
                                        <span class="lang-name">{name}</span>
                                    </a>
                                ))
                            }
                        </div>
                    </div>

                    <!-- Collapse Menu Toggle Button (on the right on mobile) -->
                    <button
                        id="mobileMenuToggle"
                        class="nav-btn menu-toggle d-lg-none"
                        type="button"
                        aria-label="Toggle navigation menu"
                        aria-expanded="false"
                        aria-controls="mobileMenu"
                    >
                        <svg class="hamburger-icon" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <line class="line-top" x1="4" x2="20" y1="6" y2="6"></line>
                            <line class="line-mid" x1="4" x2="20" y1="12" y2="12"></line>
                            <line class="line-bot" x1="4" x2="20" y1="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Mobile Collapse Menu (on the right on mobile) -->
            <div id="mobileMenu" class="mobile-collapse-menu d-lg-none" hidden aria-label="Mobile navigation">
                <nav class="mobile-menu-inner">
                    {
                        navItems.map((item) => (
                            <a
                                class:list={["mobile-nav-link", { active: item.active }]}
                                href={translatePath(item.path)}
                                aria-current={item.active ? "page" : undefined}
                            >
                                {item.label}
                            </a>
                        ))
                    }
                </nav>
            </div>
        </header>

        <main class="flex-grow-1">
            <slot />
        </main>

        <!-- ===================== FOOTER ===================== -->
        <footer class="site-footer py-5 mt-auto">
            <div class="container text-center small">
                <div class="mb-3 footer-copyright">
                    © <span id="currentYear"></span> Marc — Engineering Portfolio
                </div>
                <div class="d-flex justify-content-center gap-4 footer-links">
                    <a
                        href="https://github.com/marcravel"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="footer-link"
                        >{t("footer.github")}</a
                    >
                    <a
                        href="https://www.linkedin.com/in/marc-anjaniaina-ravelontsalama/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="footer-link"
                        >{t("footer.linkedin")}</a
                    >
                    <a
                        href={translatePath("/contacts")}
                        class="footer-link"
                        >{t("footer.contact")}</a
                    >
                </div>
            </div>
        </footer>

        <style>
            #navSentinel {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 1px;
                pointer-events: none;
                visibility: hidden;
            }

            /* Navbar Wrapper */
            .navbar-wrapper {
                position: sticky;
                top: 0;
                left: 0;
                right: 0;
                width: 100%;
                height: var(--navbar-height);
                z-index: 1000;
                display: flex;
                align-items: center;
                background-color: var(--color-navbar-bg);
                border-bottom: 1px solid var(--color-border-subtle);
                box-shadow: 0 4px 20px rgba(7, 50, 106, 0.18);
                transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
            }

            /* Home Page at top: Transparent so carousel image is background */
            .navbar-wrapper.navbar-home {
                margin-bottom: calc(-1 * var(--navbar-height));
                background-color: transparent;
                border-bottom-color: transparent;
                box-shadow: none;
            }

            /* Subtle gradient overlay at top of home to guarantee legibility over any photo */
            .navbar-wrapper.navbar-home::before {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(to bottom, rgba(7, 50, 106, 0.8) 0%, rgba(7, 50, 106, 0.25) 70%, transparent 100%);
                pointer-events: none;
                transition: opacity 0.25s ease;
                z-index: -1;
            }

            /* When scrolled or mobile menu is open: Plain color background */
            .navbar-wrapper.navbar-home.is-scrolled,
            .navbar-wrapper.navbar-home.menu-open {
                background-color: var(--color-navbar-bg);
                border-bottom-color: var(--color-border-subtle);
                box-shadow: 0 4px 20px rgba(7, 50, 106, 0.25);
            }

            .navbar-wrapper.navbar-home.is-scrolled::before,
            .navbar-wrapper.navbar-home.menu-open::before {
                opacity: 0;
            }

            /* Navbar Container */
            .navbar-container {
                display: flex;
                align-items: center;
                justify-content: space-between;
                width: 100%;
                position: relative;
            }

            /* Brand */
            .navbar-brand {
                font-family: var(--font-display);
                font-size: 1.4rem;
                font-weight: 700;
                color: var(--color-light);
                text-decoration: none;
                letter-spacing: -0.02em;
                transition: opacity 0.2s ease;
            }

            .navbar-brand:hover {
                opacity: 0.9;
                color: var(--color-light);
            }

            /* Right Section */
            .navbar-right {
                display: flex;
                align-items: center;
                gap: 0.75rem;
            }

            @media (min-width: 992px) {
                .navbar-right {
                    gap: 1.25rem;
                }
            }

            /* Desktop Navigation */
            .nav-links {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                list-style: none;
                margin: 0;
                padding: 0;
            }

            .nav-link {
                display: inline-flex;
                align-items: center;
                padding: 0.45rem 0.95rem;
                font-size: 0.95rem;
                font-weight: 500;
                color: var(--color-text-on-dark-secondary);
                text-decoration: none;
                border-radius: var(--radius-pill);
                transition: color 0.2s ease, background-color 0.2s ease;
            }

            .nav-link:hover {
                color: var(--color-light);
                background-color: rgba(241, 247, 249, 0.12);
            }

            .nav-link.active {
                color: var(--color-light);
                font-weight: 600;
                background-color: var(--color-accent-1);
            }

            /* Nav Buttons (Language & Hamburger) */
            .nav-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-family: inherit;
                background-color: rgba(241, 247, 249, 0.08);
                border: 1px solid var(--color-border);
                color: var(--color-light);
                cursor: pointer;
                transition: background-color 0.2s ease, border-color 0.2s ease;
            }

            .nav-btn:hover {
                background-color: rgba(241, 247, 249, 0.18);
                border-color: var(--color-light);
            }

            .nav-btn:focus-visible {
                outline: 2px solid var(--color-light);
                outline-offset: 2px;
            }

            /* Language Switcher */
            .lang-wrapper {
                position: relative;
            }

            .lang-toggle {
                gap: 0.35rem;
                padding: 0.4rem 0.65rem;
                border-radius: var(--radius-pill);
                font-size: 0.85rem;
                font-weight: 600;
            }

            .lang-flag {
                font-size: 1.05rem;
                line-height: 1;
            }

            .lang-code {
                letter-spacing: 0.05em;
            }

            .dropdown-chevron {
                transition: transform 0.2s ease;
            }

            .lang-toggle[aria-expanded="true"] .dropdown-chevron {
                transform: rotate(180deg);
            }

            .lang-dropdown {
                position: absolute;
                top: calc(100% + 0.5rem);
                right: 0;
                min-width: 155px;
                background-color: var(--color-navbar-bg);
                border: 1px solid var(--color-border);
                border-radius: var(--radius-md);
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
                padding: 0.35rem;
                display: flex;
                flex-direction: column;
                gap: 0.2rem;
                z-index: 1010;
                animation: dropFade 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            }

            .lang-dropdown[hidden] {
                display: none;
            }

            .lang-option {
                display: flex;
                align-items: center;
                gap: 0.6rem;
                padding: 0.5rem 0.75rem;
                font-size: 0.9rem;
                color: var(--color-text-on-dark-secondary);
                text-decoration: none;
                border-radius: var(--radius-sm);
                transition: background-color 0.15s ease, color 0.15s ease;
            }

            .lang-option:hover {
                background-color: rgba(241, 247, 249, 0.12);
                color: var(--color-light);
            }

            .lang-option.active {
                color: var(--color-light);
                font-weight: 600;
                background-color: var(--color-accent-1);
            }

            /* Hamburger Toggle */
            .menu-toggle {
                padding: 0.45rem;
                border-radius: var(--radius-md);
            }

            .hamburger-icon {
                display: block;
            }

            .hamburger-icon line {
                transition: transform 0.25s ease, opacity 0.25s ease;
                transform-origin: center;
            }

            .menu-toggle[aria-expanded="true"] .line-top {
                transform: translateY(6px) rotate(45deg);
            }

            .menu-toggle[aria-expanded="true"] .line-mid {
                opacity: 0;
            }

            .menu-toggle[aria-expanded="true"] .line-bot {
                transform: translateY(-6px) rotate(-45deg);
            }

            /* Mobile Collapse Menu (Anchored on the right) */
            .mobile-collapse-menu {
                position: absolute;
                top: calc(100% + 0.5rem);
                right: 1rem;
                width: min(240px, calc(100vw - 2rem));
                background-color: var(--color-navbar-bg);
                border: 1px solid var(--color-border);
                border-radius: var(--radius-md);
                box-shadow: 0 12px 36px rgba(0, 0, 0, 0.4);
                padding: 0.5rem;
                z-index: 1010;
                animation: dropFade 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            }

            .mobile-collapse-menu[hidden] {
                display: none;
            }

            .mobile-menu-inner {
                display: flex;
                flex-direction: column;
                gap: 0.25rem;
            }

            .mobile-nav-link {
                display: flex;
                align-items: center;
                padding: 0.65rem 0.9rem;
                font-size: 1rem;
                font-weight: 500;
                color: var(--color-text-on-dark-secondary);
                text-decoration: none;
                border-radius: var(--radius-sm);
                transition: color 0.15s ease, background-color 0.15s ease;
            }

            .mobile-nav-link:hover {
                color: var(--color-light);
                background-color: rgba(241, 247, 249, 0.12);
            }

            .mobile-nav-link.active {
                color: var(--color-light);
                font-weight: 600;
                background-color: var(--color-accent-1);
            }

            /* Footer Styling - Dark blue background with white light text */
            .site-footer {
                background-color: var(--color-footer-bg);
                border-top: 1px solid var(--color-border-subtle);
                color: var(--color-light);
            }

            .footer-copyright {
                color: var(--color-light);
                opacity: 0.95;
                font-weight: 500;
            }

            .footer-links .footer-link {
                color: var(--color-light);
                text-decoration: none;
                transition: color var(--transition-fast), opacity var(--transition-fast);
                opacity: 0.85;
            }

            .footer-links .footer-link:hover {
                color: var(--color-palette-slate);
                opacity: 1;
            }

            @keyframes dropFade {
                from {
                    opacity: 0;
                    transform: translateY(-8px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
        </style>
        </style>

        <!-- ===================== SCRIPTS ===================== -->
        <script is:inline>
            document.addEventListener("DOMContentLoaded", () => {
                const year = document.getElementById("currentYear");
                if (year) year.textContent = new Date().getFullYear();

                const header = document.querySelector(".navbar-wrapper");
                if (!header) return;

                // Handle scroll state: plain color background when scrolling
                const updateScroll = () => {
                    const isScrolled = window.scrollY > 15;
                    header.classList.toggle("is-scrolled", isScrolled);
                };
                window.addEventListener("scroll", updateScroll, { passive: true });
                updateScroll();

                const sentinel = document.getElementById("navSentinel");
                if (header.classList.contains("navbar-home") && sentinel && "IntersectionObserver" in window) {
                    new IntersectionObserver(
                        ([entry]) => {
                            header.classList.toggle("is-scrolled", !entry.isIntersecting || window.scrollY > 15);
                        },
                        { threshold: 0 }
                    ).observe(sentinel);
                }

                // Mobile collapse menu and language dropdown controls
                const menuBtn = document.getElementById("mobileMenuToggle");
                const menu = document.getElementById("mobileMenu");
                const langBtn = document.getElementById("langToggle");
                const langMenu = document.getElementById("langMenu");
                const langWrapper = document.querySelector(".lang-wrapper");

                const setOpen = (panel, button, open) => {
                    if (!panel || !button) return;
                    panel.hidden = !open;
                    button.setAttribute("aria-expanded", String(open));
                };

                const closeLang = () => setOpen(langMenu, langBtn, false);
                const closeMenu = () => {
                    setOpen(menu, menuBtn, false);
                    header.classList.remove("menu-open");
                };

                // Hamburger toggle
                menuBtn?.addEventListener("click", (e) => {
                    e.stopPropagation();
                    const open = menu.hidden;
                    closeLang();
                    setOpen(menu, menuBtn, open);
                    header.classList.toggle("menu-open", open);
                });

                menu?.addEventListener("click", (e) => {
                    if (e.target.closest("a")) closeMenu();
                });

                // Language dropdown toggle
                langBtn?.addEventListener("click", (e) => {
                    e.stopPropagation();
                    const open = langMenu.hidden;
                    closeMenu();
                    setOpen(langMenu, langBtn, open);
                });

                langMenu?.addEventListener("click", (e) => {
                    const link = e.target.closest("a[data-lang]");
                    if (!link) return;
                    try {
                        localStorage.setItem("preferredLang", link.dataset.lang);
                    } catch {}
                });

                // Click outside to close
                document.addEventListener("click", (e) => {
                    if (!langWrapper?.contains(e.target)) closeLang();
                    if (!menu?.contains(e.target) && !menuBtn?.contains(e.target)) closeMenu();
                });

                // Escape key to close
                document.addEventListener("keydown", (e) => {
                    if (e.key === "Escape") {
                        closeLang();
                        closeMenu();
                    }
                });

                // Close mobile menu on desktop resize
                window.addEventListener("resize", () => {
                    if (window.innerWidth >= 992) {
                        closeMenu();
                    }
                });
            });
        </script>
    </body>
</html>
