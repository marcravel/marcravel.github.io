---
import { useTranslatedPath } from "../i18n/ui";
import type { Project, Lang } from "../types/project";
import { getOptimizedImagePath, normalizeBaseUrl } from "../utils/images";
import { parseProjectCategories } from "../utils/categories";

export interface Props {
    lang: Lang;
    project: Project;
}

const { project, lang } = Astro.props;
const translatePath = useTranslatedPath(lang);
const developmentStatus = project.developmentStatus?.[lang]?.trim();
const categories = parseProjectCategories(project.category[lang]);

const uiTexts = {
    en: { soon: "Details available soon", image: "Project image" },
    fr: { soon: "Détails disponibles bientôt", image: "Image du projet" },
    tr: { soon: "Detaylar yakında", image: "Proje görseli" },
};

// Determine image URL with fallback handling
let imageUrl =
    "https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=800&q=80";

if (project.image) {
    if (project.image.startsWith("http")) {
        imageUrl = project.image;
    } else {
        const baseUrl = normalizeBaseUrl(import.meta.env.BASE_URL);
        imageUrl = `${baseUrl}${getOptimizedImagePath(project.image)}`;
    }
}

const projectPath = project.slug
    ? `/projects/${project.slug}`
    : `/projects/${project.id}`;
const projectLink = translatePath(projectPath);

const isActive = project.active === 1;
const Wrapper = isActive ? "a" : "div";
const wrapperProps = isActive
    ? { href: projectLink, class: "text-decoration-none d-block h-100" }
    : { class: "d-block h-100 position-relative disabled-wrapper" };
---

<Wrapper {...wrapperProps}>
    <div class="surface h-100 project-card d-flex flex-column p-0 overflow-hidden">
        <!-- Card Background / Image section -->
        <div class="position-relative card-image-container">
            <img
                src={imageUrl}
                width="1600"
                height="900"
                loading="lazy"
                decoding="async"
                alt={`${project.title[lang]} – ${uiTexts[lang].image}`}
                class="position-absolute w-100 h-100 card-img"
            />
            <div class="position-absolute w-100 h-100 card-image-shade"></div>

            {
                !isActive && (
                    <div class="position-absolute w-100 h-100 z-2 d-flex justify-content-center align-items-center coming-soon-overlay">
                        <span class="badge badge-dark">
                            {uiTexts[lang].soon}
                        </span>
                    </div>
                )
            }

            <div class="position-absolute card-badge-categories d-flex flex-wrap gap-1">
                {categories.map((cat) => (
                    <span
                        class="badge badge-category"
                        style={`background-color: ${cat.bg}; color: ${cat.fg}; border: ${cat.border};`}
                    >
                        {cat.label}
                    </span>
                ))}
            </div>

            {
                developmentStatus && (
                    <span class="position-absolute badge badge-green card-badge-status">
                        {developmentStatus}
                    </span>
                )
            }
        </div>

        <!-- Card Content -->
        <div class="p-4 d-flex flex-column flex-grow-1 position-relative z-1">
            <h5 class="fw-bold mb-2 project-card-title">
                {project.title[lang]}
            </h5>
            <p class="small mb-3 project-card-stack">
                {project.techStack.join(", ")}
            </p>
            <p class="small mb-auto text-secondary project-card-desc">
                {project.description[lang]}
            </p>
            {
                project.achievements && project.achievements[lang] && (
                    <div class="mt-4 project-card-achievements">
                        <p class="small mb-0">
                            {project.achievements[lang]}
                        </p>
                    </div>
                )
            }
        </div>
    </div>
</Wrapper>

<style>
    .project-card {
        background-color: var(--white);
        border: var(--stroke);
        border-radius: var(--radius);
        box-shadow: var(--die), var(--drop);
        transition:
            transform 160ms var(--spring),
            box-shadow 160ms var(--ease);
    }

    .project-card:hover {
        transform: translateY(-3px) rotate(-1deg);
        box-shadow: var(--die), var(--lift);
    }

    .card-image-container {
        height: 200px;
        border-bottom: 2px solid var(--ink);
        overflow: hidden;
    }

    .card-img {
        object-fit: cover;
        object-position: center;
        top: 0;
        left: 0;
        transition: transform 200ms var(--ease);
    }

    .project-card:hover .card-img {
        transform: scale(1.03);
    }

    .card-image-shade {
        background: linear-gradient(to top, rgb(31 31 31 / 0.72) 0%, transparent 65%);
        top: 0;
        left: 0;
        pointer-events: none;
    }

    .card-badge-category,
    .card-badge-categories {
        bottom: 12px;
        left: 12px;
        z-index: 2;
        max-width: calc(100% - 24px);
    }

    .card-badge-status {
        top: 12px;
        right: 12px;
        z-index: 2;
    }

    .project-card-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--ink);
        letter-spacing: -0.02em;
        line-height: 1.25;
    }

    .project-card-stack {
        font-family: var(--font-mono);
        color: var(--cta);
        font-weight: 600;
        font-size: 0.8125rem;
    }

    .project-card-desc {
        line-height: 1.5;
        color: var(--ink-2);
    }

    .project-card-achievements {
        background: var(--p-blue);
        border: 2px solid var(--ink);
        border-radius: var(--radius-s);
        padding: 10px 14px;
        box-shadow: 0 2px 0 0 var(--ink);
        font-weight: 600;
        color: var(--ink);
    }

    .disabled-wrapper {
        cursor: default;
    }

    .coming-soon-overlay {
        top: 0;
        left: 0;
        background-color: rgb(31 31 31 / 0.92);
        opacity: 0;
        transition: opacity 200ms var(--ease);
    }

    .disabled-wrapper:hover .coming-soon-overlay {
        opacity: 1;
    }
</style>
