---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../ProjectCard.astro";
import projectsData from "../../data/projects.json";
import { useTranslatedPath } from "../../i18n/ui";
import { getImage, Image } from "astro:assets";
import embeddedIcon from "../../assets/icons/embedded.png";
import pcbIcon from "../../assets/icons/pcb-design.png";
import controlIcon from "../../assets/icons/control.png";
import linuxIcon from "../../assets/icons/linux.png";

const skillIcons = [embeddedIcon, pcbIcon, controlIcon, embeddedIcon, controlIcon, linuxIcon];

export interface Props {
    lang: "en" | "fr" | "tr";
}

const { lang } = Astro.props;
const translatePath = useTranslatedPath(lang);

/* ---------- Data ---------- */

const carouselModules = import.meta.glob<{ default: ImageMetadata }>(
    "../../assets/carousel/*.jpg",
    { eager: true },
);
const carouselImages = Object.entries(carouselModules)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, mod]) => mod.default);
const heroWidths = [640, 960, 1280, 1920];
const heroPreloadImages = await Promise.all(
    heroWidths.map((width) =>
        getImage({ src: carouselImages[0], width, format: "webp" }),
    ),
);

const activeProjects = projectsData.filter((project) => project.active === 1);
const gridClassDesktop =
    activeProjects.length === 2 ? "lg-grid-cols-2" : "lg-grid-cols-3";

/* ---------- Copy ---------- */

const texts = {
    en: {
        title: "Marc Ravelontsalama | Embedded Systems Engineer",
        description:
            "Embedded systems, firmware, electronics, PCB design, and control engineering projects by Marc Ravelontsalama.",
        kickerHero: "Personal Portfolio",
        kickerSkills: "Engineering Disciplines",
        kickerProjects: "Featured Works",
        carousel: { prev: "Previous slide", next: "Next slide", slide: "Slide" },
        slides: [
            {
                title: "Hi, I'm Marc Ravelontsalama",
                text: "Final-year Electrical and Electronics Engineering student passionate about <strong>embedded systems</strong>, firmware, control engineering, and intelligent systems.",
            },
            {
                title: "OPEN TO INTERNSHIPS",
                text: "Embedded systems and power electronics roles in the EU, starting early 2027.",
            },
            {
                title: "WHAT I BUILD",
                text: "Embedded firmware, power electronics, and control systems, from schematic to working hardware.",
            },
        ],
        skillsHeading: "Skills Overview",
        skills: [
            {
                title: "Embedded Firmware",
                desc: "Microcontroller programming and low-level firmware development.",
                items: ["C / C++", "STM32, ESP32, PIC, Arduino", "Bare-metal Programming", "HAL & Peripheral Drivers"],
            },
            {
                title: "Electronics & PCB Design",
                desc: "Electronic circuit design, board development, and hardware integration.",
                items: ["Analog & Digital Electronics", "Circuit Design", "Altium Designer", "PCB Layout", "Component Selection", "Hardware Prototyping"],
            },
            {
                title: "Control Systems",
                desc: "Design and implementation of feedback control systems.",
                items: ["PID / PI / PD Control", "Fuzzy Logic", "Digital Control", "Feedback Systems", "System Modeling"],
            },
            {
                title: "Sensors & Instrumentation",
                desc: "Measurement systems, data acquisition, and hardware communication.",
                items: ["Sensor Integration", "ADC", "I²C, SPI, UART", "Data Acquisition", "Signal Conditioning", "Measurement Systems"],
            },
            {
                title: "Power Electronics",
                desc: "Power conversion and electronic power-stage design.",
                items: ["DC-DC Converters", "Buck Converters", "MOSFETs & Gate Drivers", "Power Management", "LTspice", "Circuit Simulation"],
            },
            {
                title: "Linux & Development Tools",
                desc: "Software development environments and engineering workflows.",
                items: ["Linux", "Python", "Git", "Bash", "Debugging & Testing", "Serial Communication", "Telemetry & API Integration"],
            },
        ],
        selectedProjects: "Selected Projects",
        viewAll: "View All",
        inDevelopment: "Additional systems in active development.",
    },
    fr: {
        title: "Marc Ravelontsalama | Ingénieur systèmes embarqués",
        description:
            "Projets de Marc Ravelontsalama en systèmes embarqués, firmware, électronique, conception de circuits imprimés et contrôle.",
        kickerHero: "Portfolio Personnel",
        kickerSkills: "Disciplines d'Ingénierie",
        kickerProjects: "Travaux Sélectionnés",
        carousel: {
            prev: "Diapositive précédente",
            next: "Diapositive suivante",
            slide: "Diapositive",
        },
        slides: [
            {
                title: "Bonjour, je suis Marc Ravelontsalama",
                text: "Étudiant en dernière année de génie électrique et électronique, passionné par les <strong>systèmes embarqués</strong>, le firmware, l'automatique et les systèmes intelligents.",
            },
            {
                title: "OUVERT AUX STAGES",
                text: "Je recherche un stage en systèmes embarqués et électronique de puissance dans l’UE, début 2027.",
            },
            {
                title: "CE QUE JE CONSTRUIS",
                text: "Firmware embarqué, électronique de puissance et systèmes de commande, du schéma au matériel fonctionnel.",
            },
        ],
        skillsHeading: "Aperçu des compétences",
        skills: [
            {
                title: "Firmware embarqué",
                desc: "Programmation de microcontrôleurs et développement de firmware bas niveau.",
                items: ["C / C++", "STM32, ESP32, PIC, Arduino", "Programmation bare-metal", "HAL et pilotes de périphériques"],
            },
            {
                title: "Électronique et conception de PCB",
                desc: "Conception de circuits électroniques, développement de cartes et intégration matérielle.",
                items: ["Électronique analogique et numérique", "Conception de circuits", "Altium Designer", "Routage PCB", "Sélection des composants", "Prototypage matériel"],
            },
            {
                title: "Systèmes de contrôle",
                desc: "Conception et implémentation de systèmes de contrôle en boucle fermée.",
                items: ["Contrôle PID / PI / PD", "Logique floue", "Contrôle numérique", "Systèmes en rétroaction", "Modélisation des systèmes"],
            },
            {
                title: "Capteurs et instrumentation",
                desc: "Systèmes de mesure, acquisition de données et communication matérielle.",
                items: ["Intégration de capteurs", "ADC", "I²C, SPI, UART", "Acquisition de données", "Conditionnement du signal", "Systèmes de mesure"],
            },
            {
                title: "Électronique de puissance",
                desc: "Conversion de puissance et conception d'étages de puissance électroniques.",
                items: ["Convertisseurs DC-DC", "Convertisseurs Buck", "MOSFET et pilotes de grille", "Gestion de l'énergie", "LTspice", "Simulation de circuits"],
            },
            {
                title: "Linux et outils de développement",
                desc: "Environnements de développement logiciel et flux de travail d'ingénierie.",
                items: ["Linux", "Python", "Git", "Bash", "Débogage et tests", "Communication série", "Télémétrie et intégration d'API"],
            },
        ],
        selectedProjects: "Projets Sélectionnés",
        viewAll: "Voir tout",
        inDevelopment: "Systèmes supplémentaires en cours de développement.",
    },
    tr: {
        title: "Marc Ravelontsalama | Gömülü Sistemler Mühendisi",
        description:
            "Marc Ravelontsalama'nın gömülü sistemler, firmware, elektronik, PCB tasarımı ve kontrol projeleri.",
        kickerHero: "Kişisel Portfolyo",
        kickerSkills: "Mühendislik Alanları",
        kickerProjects: "Seçili Çalışmalar",
        carousel: { prev: "Önceki slayt", next: "Sonraki slayt", slide: "Slayt" },
        slides: [
            {
                title: "Merhaba, ben Marc Ravelontsalama",
                text: "Elektrik-Elektronik Mühendisliği son sınıf öğrencisi; <strong>gömülü sistemler</strong>, firmware, kontrol mühendisliği ve akıllı sistemler konusunda tutkulu.",
            },
            {
                title: "STAJA AÇIĞIM",
                text: "Gömülü sistemler ve güç elektroniği alanında, 2027 başlangıçlı staj arıyorum.",
            },
            {
                title: "NELER GELİŞTİRİYORUM",
                text: "Gömülü yazılım, güç elektroniği ve kontrol sistemleri; şemadan çalışan donanıma.",
            },
        ],
        skillsHeading: "Yeteneklere Genel Bakış",
        skills: [
            {
                title: "Gömülü Firmware",
                desc: "Mikrodenetleyici programlama ve düşük seviyeli firmware geliştirme.",
                items: ["C / C++", "STM32, ESP32, PIC, Arduino", "Bare-metal Programlama", "HAL ve Çevre Birimi Sürücüleri"],
            },
            {
                title: "Elektronik ve PCB Tasarımı",
                desc: "Elektronik devre tasarımı, kart geliştirme ve donanım entegrasyonu.",
                items: ["Analog ve Dijital Elektronik", "Devre Tasarımı", "Altium Designer", "PCB Yerleşimi", "Bileşen Seçimi", "Donanım Prototipleme"],
            },
            {
                title: "Kontrol Sistemleri",
                desc: "Geri beslemeli kontrol sistemlerinin tasarımı ve uygulanması.",
                items: ["PID / PI / PD Kontrol", "Bulanık Mantık", "Dijital Kontrol", "Geri Besleme Sistemleri", "Sistem Modellemesi"],
            },
            {
                title: "Sensörler ve Ölçüm Sistemleri",
                desc: "Ölçüm sistemleri, veri toplama ve donanım haberleşmesi.",
                items: ["Sensör Entegrasyonu", "ADC", "I²C, SPI, UART", "Veri Toplama", "Sinyal Koşullandırma", "Ölçüm Sistemleri"],
            },
            {
                title: "Güç Elektroniği",
                desc: "Güç dönüşümü ve elektronik güç katı tasarımı.",
                items: ["DC-DC Dönüştürücüler", "Buck Dönüştürücüler", "MOSFET'ler ve Gate Driver'lar", "Güç Yönetimi", "LTspice", "Devre Simülasyonu"],
            },
            {
                title: "Linux ve Geliştirme Araçları",
                desc: "Yazılım geliştirme ortamları ve mühendislik iş akışları.",
                items: ["Linux", "Python", "Git", "Bash", "Hata Ayıklama ve Test", "Seri Haberleşme", "Telemetri ve API Entegrasyonu"],
            },
        ],
        selectedProjects: "Seçili Projeler",
        viewAll: "Tümünü Gör",
        inDevelopment: "Geliştirilme aşamasında olan ek sistemler.",
    },
};
const t = texts[lang];

/* ---------- Structured data ---------- */

const personSchema = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Marc Anjaniaina Ravelontsalama",
    url: new URL(Astro.url.pathname, Astro.site).toString(),
    sameAs: [
        "https://github.com/marcravel",
        "https://www.linkedin.com/in/marc-anjaniaina-ravelontsalama/",
    ],
    jobTitle: "Embedded Systems Engineer",
    description:
        "Final-year Electrical-Electronics Engineering student focused on embedded firmware, electronics, PCB design and control.",
    worksFor: {
        "@type": "EducationalOrganization",
        name: "Selçuk University",
    },
    knowsAbout: [
        "Electronics",
        "Embedded Systems",
        "Firmware",
        "PCB Design",
        "Control",
        "Linux",
    ],
};
---

<BaseLayout title={t.title} description={t.description}>
    <link
        rel="preload"
        as="image"
        href={heroPreloadImages[0].src}
        media="(max-width: 768px)"
        type="image/webp"
        fetchpriority="high"
    />
    <link
        rel="preload"
        as="image"
        href={heroPreloadImages[3].src}
        media="(min-width: 769px)"
        type="image/webp"
        fetchpriority="high"
    />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- ===================== HERO CAROUSEL ===================== -->
    <header
        class="hero-carousel"
        data-carousel
        aria-roledescription="carousel"
        aria-label="Portfolio introduction"
    >
        {
            t.slides.map((slide, index) => {
                const image = carouselImages[index % carouselImages.length];
                const Heading = index === 0 ? "h1" : "h2";
                return (
                    <div
                        class="hero-slide"
                        data-state={index === 0 ? "active" : "after"}
                        role="group"
                        aria-roledescription="slide"
                        aria-label={`${index + 1} / ${t.slides.length}`}
                    >
                        <Image
                            class="hero-slide-image"
                            src={image}
                            widths={[640, 960, 1280, 1920]}
                            sizes="100vw"
                            format="webp"
                            alt=""
                            aria-hidden="true"
                            loading={index === 0 ? "eager" : "lazy"}
                            fetchpriority={index === 0 ? "high" : undefined}
                            decoding="async"
                        />
                        <div class="hero-slide-overlay" />
                        <div class="container hero-slide-content d-flex align-items-center justify-content-center">
                            <div class:list={["hero-copy", { "animate-fade-up": index === 0 }]}>
                                <p class="kicker kicker-on-night mb-2">
                                    <span>{t.kickerHero}</span>
                                </p>
                                <Heading class="mb-3 hero-title">{slide.title}</Heading>
                                <p class="lead mb-0 hero-lead" set:html={slide.text} />
                            </div>
                        </div>
                    </div>
                );
            })
        }

        <div class="hero-controls">
            <button type="button" class="hero-arrow" data-prev aria-label={t.carousel.prev}>
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M15 18l-6-6 6-6" />
                </svg>
            </button>

            <div class="hero-dots">
                {
                    t.slides.map((_, index) => (
                        <button
                            type="button"
                            class="hero-dot"
                            data-dot={index}
                            aria-label={`${t.carousel.slide} ${index + 1}`}
                            aria-current={index === 0 ? "true" : undefined}
                        />
                    ))
                }
            </div>

            <button type="button" class="hero-arrow" data-next aria-label={t.carousel.next}>
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 18l6-6-6-6" />
                </svg>
            </button>
        </div>
    </header>

    <!-- ===================== SKILLS ===================== -->
    <section class="section skills-section">
        <div class="container">
            <div class="skills-wrapper">
                <div class="text-center mb-5">
                    <p class="kicker justify-content-center text-center">
                        <span>{t.kickerSkills}</span>
                    </p>
                    <h2 class="section-title mb-0"><span>{t.skillsHeading}</span></h2>
                </div>

                <div class="grid grid-cols-1 md-grid-cols-2 lg-grid-cols-3 gap-4 skills-grid animate-fade-up">
                    {
                        t.skills.map((skill, index) => {
                            const icon = skillIcons[index];
                            return (
                                <article class="skill-card">
                                    <div class="stamp-icon mb-3">
                                        <img
                                            src={icon.src}
                                            width="30"
                                            height="30"
                                            alt=""
                                            aria-hidden="true"
                                            class="skill-icon"
                                            loading="lazy"
                                            decoding="async"
                                        />
                                    </div>
                                    <h3 class="skill-title mb-2">{skill.title}</h3>
                                    <p class="skill-description mb-3">{skill.desc}</p>
                                    <ul class="skill-tags" aria-label={skill.title}>
                                        {skill.items.map((item) => <li class="tag">{item}</li>)}
                                    </ul>
                                </article>
                            );
                        })
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- ===================== PROJECTS PREVIEW ===================== -->
    <section class="section projects-section">
        <div class="container">
            <div class="d-flex flex-wrap justify-content-between align-items-center projects-header gap-3 mb-5">
                <div>
                    <p class="kicker mb-1">
                        <span>{t.kickerProjects}</span>
                    </p>
                    <h2 class="section-title text-start mb-0"><span>{t.selectedProjects}</span></h2>
                </div>
                <a href={translatePath("/projects")} class="btn btn-outline view-all">
                    {t.viewAll} &rarr;
                </a>
            </div>

            <div class={`grid grid-cols-1 md-grid-cols-2 ${gridClassDesktop} gap-4 projects-grid animate-fade-up`}>
                {activeProjects.map((project) => <ProjectCard project={project} lang={lang} />)}
            </div>

            <div class="in-development-wrapper text-center mt-5">
                <div class="in-development-pill">
                    <span class="status-beacon"></span>
                    <span class="in-development-text">{t.inDevelopment}</span>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    /* ---------- Hero carousel ---------- */
    .hero-carousel {
        position: relative;
        display: grid;
        grid-template-rows: minmax(min(640px, 80vh), auto);
        overflow: hidden;
        background-color: var(--night);
        border-bottom: 2px solid var(--ink);
    }

    .hero-slide {
        position: relative;
        grid-area: 1 / 1;
        display: flex;
        align-items: center;
        transform: translateX(100%);
        transition: transform var(--slide-ms, 0.8s) ease-in-out;
    }
    .hero-slide[data-state="active"] {
        transform: none;
    }
    .hero-slide[data-state="before"] {
        transform: translateX(-100%);
    }
    .hero-slide.no-transition {
        transition: none;
    }

    .hero-slide-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.28;
    }

    .hero-slide-overlay {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(to right, rgb(42 42 42 / 0.65) 1px, transparent 1px),
            linear-gradient(to bottom, rgb(42 42 42 / 0.65) 1px, transparent 1px),
            linear-gradient(90deg, rgb(31 31 31 / 0.96), rgb(31 31 31 / 0.8));
        background-size: 40px 40px, 40px 40px, auto;
    }

    .hero-slide-content {
        position: relative;
        z-index: 1;
        width: 100%;
        min-width: 0;
        padding-block: 5rem;
        text-align: center;
    }

    .hero-copy {
        width: 100%;
        max-width: 800px;
        color: var(--on-night);
    }

    .kicker-on-night {
        color: var(--on-night-2);
    }

    .kicker-on-night::before,
    .kicker-on-night::after {
        color: var(--blue);
    }

    .hero-title {
        font-size: clamp(2rem, 5vw, 3.75rem);
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.035em;
        text-transform: uppercase;
        color: var(--on-night);
    }

    .hero-lead {
        color: var(--on-night);
        font-size: clamp(1.1rem, 1.8vw, 1.35rem);
        line-height: 1.5;
        opacity: 0.95;
    }

    .hero-copy strong {
        color: var(--t-yellow);
        font-weight: 700;
    }

    /* Controls: [ prev ] • • • [ next ] along the bottom */
    .hero-controls {
        position: absolute;
        inset-inline: 0;
        bottom: 1.5rem;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
    }

    .hero-arrow {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        padding: 0;
        color: var(--white);
        background-color: var(--night-2);
        border: 2px solid var(--white);
        border-radius: var(--radius-full);
        box-shadow: 0 4px 0 0 var(--ink);
        transition:
            transform 160ms var(--spring),
            background-color 160ms var(--ease),
            box-shadow 160ms var(--ease);
    }

    .hero-arrow:hover {
        background-color: var(--cta);
        transform: translateY(-2px) rotate(-2deg);
        box-shadow: 0 6px 0 0 var(--ink);
    }

    .hero-arrow:active {
        transform: translateY(2px);
        box-shadow: 0 1px 0 0 var(--ink);
    }

    .hero-dots {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .hero-dot {
        position: relative;
        width: 12px;
        height: 12px;
        padding: 0;
        background: transparent;
        border: 2px solid var(--white);
        border-radius: var(--radius-full);
        box-shadow: 0 2px 0 0 var(--ink);
        transition:
            width 180ms var(--spring),
            background-color 180ms var(--ease),
            border-color 180ms var(--ease);
    }

    .hero-dot::after {
        content: "";
        position: absolute;
        inset: -0.5rem;
    }

    .hero-dot[aria-current="true"] {
        width: 32px;
        background-color: var(--t-yellow);
        border-color: var(--t-yellow);
    }

    /* ---------- Skills Section ---------- */
    .skills-grid {
      margin-top: 2rem;
    }

    .skill-card {
        background: var(--white);
        border: var(--stroke);
        border-radius: var(--radius);
        padding: 28px 24px;
        box-shadow: var(--die), var(--drop);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        transform: rotate(var(--deg, 0deg));
        transition:
            transform 160ms var(--spring),
            box-shadow 160ms var(--ease);
    }

    .skill-card:nth-child(1) { --deg: -0.6deg; }
    .skill-card:nth-child(2) { --deg: 0.8deg; }
    .skill-card:nth-child(3) { --deg: -0.5deg; }
    .skill-card:nth-child(4) { --deg: 0.6deg; }
    .skill-card:nth-child(5) { --deg: -0.4deg; }
    .skill-card:nth-child(6) { --deg: 0.7deg; }

    .skill-card:hover {
        transform: translateY(-4px) rotate(calc(var(--deg, 0deg) - 1.2deg));
        box-shadow: var(--die), var(--lift);
    }

    .skill-icon {
        width: 30px;
        height: 30px;
        object-fit: contain;
    }

    .skill-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--ink);
        letter-spacing: -0.02em;
    }

    .skill-description {
        color: var(--ink-2);
        font-size: 0.9375rem;
        line-height: 1.5;
    }

    .skill-tags {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 6px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    /* ---------- Projects Section ---------- */
    .in-development-wrapper {
        display: flex;
        justify-content: center;
    }

    .in-development-pill {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 10px 22px;
        background-color: var(--white);
        border: var(--stroke);
        border-radius: var(--radius-full);
        box-shadow: var(--die), var(--drop);
    }

    .status-beacon {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: var(--green);
        box-shadow: 0 0 0 2px rgb(52 168 83 / 0.3);
        animation: ping 2s infinite;
    }

    .in-development-text {
        font-family: var(--font-mono);
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--ink);
    }
</style>

<script>
    const AUTOPLAY_MS = 7000;
    const TRANSITION_MS = 1000;

    const root = document.querySelector<HTMLElement>("[data-carousel]");

    if (root) {
        const slides = Array.from(root.querySelectorAll<HTMLElement>(".hero-slide"));
        const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dot]"));
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        root.style.setProperty("--slide-ms", `${TRANSITION_MS}ms`);

        let current = 0;
        let locked = false;
        let paused = false;
        let isVisible = true;
        let timer: number | undefined;

        const render = () => {
            slides.forEach((slide, i) => {
                slide.inert = i !== current;
                slide.setAttribute("aria-hidden", String(i !== current));
            });
            dots.forEach((dot, i) => {
                if (i === current) dot.setAttribute("aria-current", "true");
                else dot.removeAttribute("aria-current");
            });
        };

        const goTo = (target: number, dir: 1 | -1) => {
            if (locked || target === current) return;
            locked = true;

            const outgoing = slides[current];
            const incoming = slides[target];

            incoming.classList.add("no-transition");
            incoming.dataset.state = dir === 1 ? "after" : "before";
            void incoming.offsetWidth;
            incoming.classList.remove("no-transition");

            outgoing.dataset.state = dir === 1 ? "before" : "after";
            incoming.dataset.state = "active";

            current = target;
            render();
            window.setTimeout(() => (locked = false), TRANSITION_MS);
        };

        const next = () => goTo((current + 1) % slides.length, 1);
        const prev = () => goTo((current - 1 + slides.length) % slides.length, -1);

        const stop = () => {
            window.clearInterval(timer);
            timer = undefined;
        };
        const start = () => {
            if (reduceMotion || paused || !isVisible || document.hidden || timer !== undefined) return;
            timer = window.setInterval(next, AUTOPLAY_MS);
        };
        const restart = () => {
            stop();
            start();
        };

        root.querySelector("[data-next]")?.addEventListener("click", () => {
            next();
            restart();
        });
        root.querySelector("[data-prev]")?.addEventListener("click", () => {
            prev();
            restart();
        });
        dots.forEach((dot, i) =>
            dot.addEventListener("click", () => {
                goTo(i, i > current ? 1 : -1);
                restart();
            }),
        );

        root.addEventListener("mouseenter", () => {
            paused = true;
            stop();
        });
        root.addEventListener("mouseleave", () => {
            paused = false;
            start();
        });
        root.addEventListener("focusin", () => {
            if (root.querySelector(":focus-visible")) {
                paused = true;
                stop();
            }
        });
        root.addEventListener("focusout", () => {
            paused = false;
            start();
        });

        document.addEventListener("visibilitychange", () => {
            if (document.hidden) stop();
            else start();
        });

        const visibilityObserver = new IntersectionObserver(
            ([entry]) => {
                isVisible = entry.isIntersecting;
                if (isVisible) start();
                else stop();
            },
            { threshold: 0.1 },
        );
        visibilityObserver.observe(root);

        if (!document.hidden) {
            start();
        }

        render();
    }
</script>
