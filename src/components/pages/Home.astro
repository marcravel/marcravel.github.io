---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../ProjectCard.astro";
import projectsData from "../../data/projects.json";
import profileImg from "../../assets/profile.jpeg";
import { useTranslatedPath } from "../../i18n/ui";

export interface Props {
    lang: "en" | "fr" | "tr";
}
const { lang } = Astro.props;
const translatePath = useTranslatedPath(lang);
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;

const activeProjects = projectsData.filter((project) => project.active === 1);
const gridClassDesktop =
    activeProjects.length === 2 ? "lg-grid-cols-2" : "lg-grid-cols-3";

const texts = {
    en: {
        title: "Marc Ravelontsalama | Embedded Systems Engineer",
        description:
            "Embedded systems, firmware, electronics, PCB design and control projects by Marc Ravelontsalama.",
        portfolio:
            "EEE student · Embedded systems, power electronics & control · Linux · Building things that work on real hardware",
        greeting: "Hi, I'm Marc.",
        subtitle: "Embedded Systems Engineer | Firmware, Electronics & Control",
        intro:
            "I'm a final-year Electrical-Electronics Engineering student at Selçuk University (Konya, Turkey), currently on Erasmus+ at Riga Technical University. I design and program embedded systems: I build the hardware, then write the firmware that runs it. My work sits between electronics, control and software, with Linux as my daily environment. I'm currently designing a digitally controlled buck converter, from the custom PCB to the firmware and Linux telemetry. I also run Code & Copper, a YouTube channel documenting technical projects. I'm looking for an embedded or electronics internship in the EU.",
        view_projects: "View Projects",
        download_cv: "Download CV",
        skills: "Skills Overview",
        programming: {
            title: "Embedded Firmware",
            desc: "C/C++ on microcontrollers. STM32, ESP32, PIC, Arduino, bare-metal and HAL firmware.",
        },
        embedded: {
            title: "Electronics & PCB Design",
            desc: "Schematic and PCB design, circuit design, power stages, sensor and actuator interfacing.",
        },
        electronics: {
            title: "Control",
            desc: "Digital control loops, sensors and actuators, PID and fuzzy logic.",
        },
        robotics: {
            title: "Linux & Tooling",
            desc: "Linux development environment, Python, Git, serial and device interfaces, telemetry and frontend/API glue. Familiar with ML fundamentals and OpenCV.",
        },
        selected_projects: "Selected Projects",
        view_all: "View All",
        in_development: "Additional systems in active development.",
    },
    fr: {
        title: "Marc Ravelontsalama | Ingénieur systèmes embarqués",
        description:
            "Projets de Marc Ravelontsalama en systèmes embarqués, firmware, électronique, conception de circuits imprimés et contrôle.",
        portfolio:
            "Étudiant en EEE · Systèmes embarqués, électronique de puissance et contrôle · Linux · Construire des systèmes qui fonctionnent sur du vrai matériel",
        greeting: "Bonjour, je suis Marc.",
        subtitle: "Ingénieur systèmes embarqués | Firmware, électronique et contrôle",
        intro:
            "Je suis étudiant en dernière année de génie électrique et électronique à l'Université de Selçuk (Konya, Turquie), actuellement en Erasmus+ à la Riga Technical University. Je conçois et programme des systèmes embarqués : je construis le matériel, puis j'écris le firmware qui le fait fonctionner. Mon travail se situe entre l'électronique, le contrôle et le logiciel, avec Linux comme environnement quotidien. Je conçois actuellement un convertisseur buck à commande numérique, du circuit imprimé personnalisé au firmware et à la télémétrie Linux. Je dirige également Code & Copper, une chaîne YouTube qui documente des projets techniques. Je recherche un stage en systèmes embarqués ou en électronique dans l'Union européenne.",
        view_projects: "Voir les projets",
        download_cv: "Télécharger CV",
        skills: "Aperçu des compétences",
        programming: {
            title: "Firmware embarqué",
            desc: "C/C++ sur microcontrôleurs. STM32, ESP32, PIC, Arduino, firmware bare-metal et HAL.",
        },
        embedded: {
            title: "Électronique et conception de circuits imprimés",
            desc: "Schémas et conception de circuits imprimés, conception de circuits, étages de puissance, interfaces capteurs et actionneurs.",
        },
        electronics: {
            title: "Contrôle",
            desc: "Boucles de contrôle numériques, capteurs et actionneurs, PID et logique floue.",
        },
        robotics: {
            title: "Linux et outils",
            desc: "Environnement de développement Linux, Python, Git, interfaces série et périphériques, télémétrie et intégration frontend/API. Connaissances des fondamentaux du ML et d'OpenCV.",
        },
        selected_projects: "Projets Sélectionnés",
        view_all: "Voir tout",
        in_development: "Systèmes supplémentaires en cours de développement.",
    },
    tr: {
        title: "Marc Ravelontsalama | Gömülü Sistemler Mühendisi",
        description:
            "Marc Ravelontsalama'nın gömülü sistemler, firmware, elektronik, PCB tasarımı ve kontrol projeleri.",
        portfolio:
            "EEE öğrencisi · Gömülü sistemler, güç elektroniği ve kontrol · Linux · Gerçek donanım üzerinde çalışan sistemler geliştiriyorum",
        greeting: "Merhaba, ben Marc.",
        subtitle: "Gömülü Sistemler Mühendisi | Firmware, Elektronik ve Kontrol",
        intro:
            "Selçuk Üniversitesi'nde (Konya, Türkiye) son sınıf Elektrik-Elektronik Mühendisliği öğrencisiyim ve şu anda Riga Technical University'de Erasmus+ yapıyorum. Gömülü sistemler tasarlıyor ve programlıyorum: donanımı kuruyor, ardından sistemi çalıştıran firmware'i yazıyorum. Çalışmalarım elektronik, kontrol ve yazılımın kesişiminde; günlük geliştirme ortamım Linux. Şu anda özel PCB'den firmware'e ve Linux telemetrisine kadar dijital kontrollü bir buck dönüştürücü tasarlıyorum. Ayrıca teknik projeleri belgeleyen Code & Copper adlı bir YouTube kanalı yürütüyorum. Avrupa Birliği'nde gömülü sistemler veya elektronik alanında staj arıyorum.",
        view_projects: "Projeleri Gör",
        download_cv: "CV İndir",
        skills: "Yeteneklere Genel Bakış",
        programming: {
            title: "Gömülü Firmware",
            desc: "Mikrodenetleyiciler üzerinde C/C++. STM32, ESP32, PIC, Arduino, bare-metal ve HAL firmware.",
        },
        embedded: {
            title: "Elektronik ve PCB Tasarımı",
            desc: "Şematik ve PCB tasarımı, devre tasarımı, güç katları, sensör ve aktüatör arayüzleri.",
        },
        electronics: {
            title: "Kontrol",
            desc: "Dijital kontrol döngüleri, sensörler ve aktüatörler, PID ve bulanık mantık.",
        },
        robotics: {
            title: "Linux ve Araçlar",
            desc: "Linux geliştirme ortamı, Python, Git, seri ve cihaz arayüzleri, telemetri ve frontend/API entegrasyonu. ML temelleri ve OpenCV hakkında bilgi sahibi.",
        },
        selected_projects: "Seçili Projeler",
        view_all: "Tümünü Gör",
        in_development: "Geliştirilme aşamasında olan ek sistemler.",
    },
};
const t = texts[lang];
---

<BaseLayout title={t.title} description={t.description}>
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Marc Anjaniaina Ravelontsalama",
        url: new URL(Astro.url.pathname, Astro.site).toString(),
        sameAs: [
            "https://github.com/marcravel",
            "https://www.linkedin.com/in/marc-anjaniaina-ravelontsalama/",
        ],
        jobTitle: "Embedded Systems Engineer",
        description:
            "Final-year Electrical-Electronics Engineering student focused on embedded firmware, electronics, PCB design and control.",
        worksFor: {
            "@type": "EducationalOrganization",
            name: "Selçuk University",
        },
        knowsAbout: [
            "Electronics",
            "Embedded Systems",
            "Firmware",
            "PCB Design",
            "Control",
            "Linux",
        ],
    })} />
    <!-- ===================== HERO SECTION ===================== -->
    <header
        class="section pb-5"
        style="min-height: 80vh; display: flex; align-items: center;"
    >
        <div class="container w-100">
            <div
                class="grid grid-cols-1 md-grid-cols-2 align-items-center gap-5"
            >
                <!-- Text -->
                <div class="animate-fade-up">
                    <div
                        class="d-inline-block mb-3 px-3 py-2 small"
                        style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 9999px; font-weight: 500; color: var(--color-text-primary);"
                    >
                        {t.portfolio}
                    </div>
                    <h1 class="mb-3" style="font-size: 4rem;">
                        <span class="gradient-text">{t.greeting}</span>
                    </h1>
                    <h2
                        class="mb-4 fw-light"
                        style="font-size: 1.75rem; color: var(--color-text-secondary);"
                    >
                        {t.subtitle}
                    </h2>
                    <p class="lead mb-5">
                        {t.intro}
                    </p>
                    <div class="d-flex flex-wrap gap-3">
                        <a
                            href={translatePath("/projects")}
                            class="btn btn-primary"
                        >
                            {t.view_projects}
                        </a>
                        <a
                            href={`${baseUrl}docs/cv.pdf`}
                            class="btn btn-outline"
                            download
                        >
                            {t.download_cv}
                        </a>
                    </div>
                </div>

                <!-- Profile image -->
                <div class="d-flex justify-content-center">
                    <div
                        class="glass p-2 floating-container"
                        style="border-radius: 24px; max-width: 400px; width: 100%;"
                    >
                        <img
                            src={profileImg.src}
                            class="img-fluid profile-img-hero w-100"
                            alt="Marc Ravelontsalama"
                            style="border-radius: 16px; display: block;"
                        />
                    </div>
                </div>
            </div>
        </div>
    </header>

    <style>
        @keyframes rotate3In {
            0% {
                transform: perspective(1200px) rotateY(-30deg) rotateX(15deg)
                    translateZ(-100px) scale(0.9);
                opacity: 0;
                box-shadow: 0 0 0 rgba(59, 130, 246, 0);
            }

            100% {
                transform: perspective(1000px) rotateY(-8deg) rotateX(5deg)
                    scale(1.05);
                opacity: 1;
                box-shadow: 0 20px 40px rgba(59, 130, 246, 0.3);
            }
        }

        @keyframes floating3D {
            0%,
            100% {
                transform: translateY(0) rotateY(0deg) rotateX(0deg);
            }
            50% {
                transform: translateY(-15px) rotateY(3deg) rotateX(-2deg);
            }
        }

        .floating-container {
            animation: floating3D 6s ease-in-out 1.5s infinite;
            will-change: transform;
        }

        .profile-img-hero {
            animation: rotate3In 1.5s cubic-bezier(0.175, 0.885, 0.32, 1.275)
                both;
            transform-origin: center;
            backface-visibility: hidden;
            transform: perspective(1000px) rotateY(-8deg) rotateX(5deg)
                scale(1.05);
            box-shadow: 0 20px 40px rgba(59, 130, 246, 0.3);
        }

        .skill-card {
            transition: transform 0.3s ease;
            will-change: transform;
        }
        .skill-card:hover {
            transform: translateY(-5px);
        }
    </style>

    <!-- ===================== SKILLS SECTION ===================== -->
    <section class="section py-5">
        <div class="container">
            <h2 class="mb-5 section-title"><span>{t.skills}</span></h2>

            <div
                class="grid grid-cols-1 md-grid-cols-2 lg-grid-cols-4 gap-4 animate-fade-up"
                style="animation-delay: 0.2s;"
            >
                <div
                    class="glass p-4 h-100 skill-card"
                    style="cursor: default;"
                >
                    <h5
                        class="mb-3"
                        style="color: var(--color-accent-1); font-weight: 700;"
                    >
                        {t.programming.title}
                    </h5>
                    <p class="small text-muted mb-0">{t.programming.desc}</p>
                </div>

                <div
                    class="glass p-4 h-100 skill-card"
                    style="cursor: default;"
                >
                    <h5
                        class="mb-3"
                        style="color: var(--color-accent-2); font-weight: 700;"
                    >
                        {t.embedded.title}
                    </h5>
                    <p class="small text-muted mb-0">{t.embedded.desc}</p>
                </div>

                <div
                    class="glass p-4 h-100 skill-card"
                    style="cursor: default;"
                >
                    <h5
                        class="mb-3"
                        style="color: var(--color-accent-1); font-weight: 700;"
                    >
                        {t.electronics.title}
                    </h5>
                    <p class="small text-muted mb-0">{t.electronics.desc}</p>
                </div>

                <div
                    class="glass p-4 h-100 skill-card"
                    style="cursor: default;"
                >
                    <h5
                        class="mb-3"
                        style="color: var(--color-accent-2); font-weight: 700;"
                    >
                        {t.robotics.title}
                    </h5>
                    <p class="small text-muted mb-0">{t.robotics.desc}</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ===================== PROJECTS PREVIEW ===================== -->
    <section class="section py-5 mb-5">
        <div class="container">
            <div
                class="d-flex flex-wrap justify-content-between align-items-center mb-5 gap-3"
            >
                <h2 class="section-title mb-0" style="margin-bottom: 0;">
                    <span>{t.selected_projects}</span>
                </h2>
                <a
                    href={translatePath("/projects")}
                    class="btn btn-outline"
                    style="padding: 0.5rem 1.25rem;"
                >
                    <span class="gradient-text">{t.view_all}</span>
                </a>
            </div>

            <div
                class={`grid grid-cols-1 md-grid-cols-2 ${gridClassDesktop} gap-4 animate-fade-up`}
                style="animation-delay: 0.3s;"
            >
                {
                    activeProjects.map((project) => (
                        <ProjectCard project={project} lang={lang} />
                    ))
                }
            </div>

            <div
                class="mt-5 text-center d-flex align-items-center justify-content-center gap-2 animate-fade-up"
                style="animation-delay: 0.4s;"
            >
                <span
                    style="display: inline-block; width: 8px; height: 8px; background-color: var(--color-accent-1); border-radius: 50%; box-shadow: 0 0 8px var(--color-accent-1); animation: pulseIndicator 2s infinite;"
                ></span>
                <p class="small text-muted mb-0 fst-italic">
                    {t.in_development}
                </p>
            </div>
        </div>
    </section>
</BaseLayout>
