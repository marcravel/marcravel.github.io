---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslatedPath } from "../../i18n/ui";

export interface Props {
    lang: "en" | "fr" | "tr";
}
const { lang } = Astro.props;
const translatePath = useTranslatedPath(lang);

const texts = {
    en: {
        title: "Contact - Marc",
        description: "Contact Marc about embedded systems, electronics, firmware, control, or internship opportunities.",
        kicker: "Direct Communication",
        h1: "Get in Touch",
        subtitle:
            "Always open to discussing embedded systems, electronics, firmware, control, or potential internship opportunities. Feel free to reach out.",
        sendMessage: "Send a Message",
        success: "Thanks for reaching out! I'll get back to you shortly.",
        error: "Your message could not be sent. Please try again or email me directly.",
        nameLabel: "Name",
        namePlaceholder: "John Doe",
        emailLabel: "Email",
        emailPlaceholder: "john@example.com",
        subjectLabel: "Subject",
        subjectPlaceholder: "Internship opportunities",
        messageLabel: "Message",
        messagePlaceholder: "Hello Marc, I am interested in...",
        submitBtn: "Send Message",
        connect: "Connect",
        linkedinDesc: "Connect professionally",
    },
    fr: {
        title: "Contact - Marc",
        description: "Contactez Marc au sujet des systèmes embarqués, de l'électronique, de la robotique ou d'opportunités de stage.",
        kicker: "Communication Directe",
        h1: "Contactez-moi",
        subtitle:
            "Toujours ouvert à échanger sur les systèmes embarqués, l’électronique, le firmware, l’automatique ou d’éventuelles opportunités de stage. N’hésitez pas à me contacter.",
        sendMessage: "Envoyer un message",
        success: "Merci de m'avoir contacté ! Je vous répondrai sous peu.",
        error: "Votre message n'a pas pu être envoyé. Réessayez ou contactez-moi directement par e-mail.",
        nameLabel: "Nom",
        namePlaceholder: "Jean Dupont",
        emailLabel: "E-mail",
        emailPlaceholder: "jean@exemple.com",
        subjectLabel: "Sujet",
        subjectPlaceholder: "Opportunités de stage",
        messageLabel: "Message",
        messagePlaceholder: "Bonjour Marc, ...",
        submitBtn: "Envoyer",
        connect: "Réseaux",
        linkedinDesc: "Connexion professionnelle",
    },
    tr: {
        title: "İletişim - Marc",
        description: "Gömülü sistemler, elektronik, firmware, kontrol veya olası staj fırsatları hakkında Marc ile iletişime geçin.",
        kicker: "Doğrudan İletişim",
        h1: "İletişime Geçin",
        subtitle:
            "Gömülü sistemler, elektronik, firmware, kontrol veya olası staj fırsatları hakkında konuşmaya her zaman açığım. Benimle iletişime geçmekten çekinmeyin.",
        sendMessage: "Mesaj Gönder",
        success:
            "Ulaştığınız için teşekkürler! Kısa süre içinde size döneceğim.",
        error: "Mesajınız gönderilemedi. Lütfen tekrar deneyin veya doğrudan e-posta gönderin.",
        nameLabel: "İsim",
        namePlaceholder: "Ahmet Yılmaz",
        emailLabel: "E-posta",
        emailPlaceholder: "ahmet@ornek.com",
        subjectLabel: "Konu",
        subjectPlaceholder: "Staj Fırsatları",
        messageLabel: "Mesaj",
        messagePlaceholder: "Merhaba Marc, ...",
        submitBtn: "Mesaj Gönder",
        connect: "Bağlantılar",
        linkedinDesc: "Profesyonel bağlantı kurun",
    },
};

const t = texts[lang];
---

<BaseLayout title={t.title} description={t.description}>
    <header class="page-header-dark">
        <div class="container animate-fade-up">
            <div class="text-center mb-5">
                <p class="kicker kicker-on-night justify-content-center text-center">
                    <span>{t.kicker}</span>
                </p>
                <h1 class="page-title mb-3">{t.h1}</h1>
                <p class="page-subtitle mx-auto" style="max-width: 52ch;">{t.subtitle}</p>
                <div class="header-rainbow-line mx-auto"></div>
            </div>
        </div>
    </header>

    <section class="page-body-light">
        <div class="container animate-fade-up">
            <div class="grid grid-cols-1 md-grid-cols-2 lg-grid-cols-3 gap-5 mt-4">
                <!-- Contact Form Column -->
                <div class="lg-grid-col-span-2">
                    <div class="surface p-4 p-md-5 form-surface-card">
                        <p class="kicker mb-1">
                            <span>Transmission</span>
                        </p>
                        <h3 class="mb-4 form-title">
                            {t.sendMessage}
                        </h3>

                        <!-- Web3Forms Integration -->
                        <div
                            class="p-3 mb-4 d-none form-feedback-success"
                            id="formSuccessMessage"
                        >
                            {t.success}
                        </div>
                        <div
                            class="p-3 mb-4 d-none form-feedback-error"
                            id="formErrorMessage"
                            role="alert"
                        >
                            {t.error}
                        </div>

                        <form id="contactForm">
                            <!-- Access Key -->
                            <input
                                type="hidden"
                                name="access_key"
                                value="cb44b232-2433-4145-8f06-9e7f37d1b760"
                            />

                            <div class="grid grid-cols-1 md-grid-cols-2 gap-4">
                                <div class="form-group">
                                    <label
                                        for="name"
                                        class="form-label"
                                    >{t.nameLabel}</label>
                                    <input
                                        type="text"
                                        name="name"
                                        id="name"
                                        class="form-control"
                                        required
                                        placeholder={t.namePlaceholder}
                                    />
                                </div>
                                <div class="form-group">
                                    <label
                                        for="email"
                                        class="form-label"
                                    >{t.emailLabel}</label>
                                    <input
                                        type="email"
                                        name="email"
                                        id="email"
                                        class="form-control"
                                        required
                                        placeholder={t.emailPlaceholder}
                                    />
                                </div>
                                <div
                                    class="form-group md-col-span-2"
                                >
                                    <label
                                        for="subject"
                                        class="form-label"
                                    >{t.subjectLabel}</label>
                                    <input
                                        type="text"
                                        name="subject"
                                        id="subject"
                                        class="form-control"
                                        required
                                        placeholder={t.subjectPlaceholder}
                                    />
                                </div>
                                <div
                                    class="form-group md-col-span-2"
                                >
                                    <label
                                        for="message"
                                        class="form-label"
                                    >{t.messageLabel}</label>
                                    <textarea
                                        name="message"
                                        id="message"
                                        rows="5"
                                        class="form-control"
                                        required
                                        placeholder={t.messagePlaceholder}
                                    ></textarea>
                                </div>

                                <!-- Honeypot Spam Protection -->
                                <input
                                    type="checkbox"
                                    name="botcheck"
                                    class="hidden"
                                    style="display: none;"
                                />

                                <div
                                    class="form-group md-col-span-2 mt-4"
                                >
                                    <button
                                        type="submit"
                                        id="submitButton"
                                        class="btn btn-primary btn--block py-3"
                                    >{t.submitBtn}</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Social Links Column -->
                <div>
                    <div class="d-flex flex-column gap-3 h-100 justify-content-center">
                        <div class="mb-2 d-none lg-d-block">
                            <p class="kicker mb-1">
                                <span>Channels</span>
                            </p>
                            <h3 class="social-heading mb-0">
                                {t.connect}
                            </h3>
                        </div>

                        <!-- Email Card -->
                        <a
                            href="mailto:marc.techno@protonmail.com"
                            target="_blank"
                            class="text-decoration-none social-card-link"
                        >
                            <div class="surface p-3 social-card social-card--1 d-flex align-items-center gap-3">
                                <div class="stamp-icon social-stamp">
                                    <svg
                                        aria-hidden="true"
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="22"
                                        height="22"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        viewBox="0 0 24 24"
                                    >
                                        <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                                    </svg>
                                </div>
                                <div>
                                    <h6 class="mb-1 fw-bold social-card-title">
                                        Email
                                    </h6>
                                    <span class="social-card-detail">
                                        marc.techno@protonmail.com
                                    </span>
                                </div>
                            </div>
                        </a>

                        <!-- LinkedIn Card -->
                        <a
                            href="https://www.linkedin.com/in/marc-anjaniaina-ravelontsalama/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-decoration-none social-card-link"
                        >
                            <div class="surface p-3 social-card social-card--2 d-flex align-items-center gap-3">
                                <div class="stamp-icon social-stamp">
                                    <svg
                                        aria-hidden="true"
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="20"
                                        height="20"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        viewBox="0 0 24 24"
                                    >
                                        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                                        <rect width="4" height="12" x="2" y="9"></rect>
                                        <circle cx="4" cy="4" r="2"></circle>
                                    </svg>
                                </div>
                                <div>
                                    <h6 class="mb-1 fw-bold social-card-title">
                                        LinkedIn
                                    </h6>
                                    <span class="social-card-detail">
                                        {t.linkedinDesc}
                                    </span>
                                </div>
                            </div>
                        </a>

                        <!-- GitHub Card -->
                        <a
                            href="https://github.com/marcravel"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-decoration-none social-card-link"
                        >
                            <div class="surface p-3 social-card social-card--3 d-flex align-items-center gap-3">
                                <div class="stamp-icon social-stamp">
                                    <svg
                                        aria-hidden="true"
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="22"
                                        height="22"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        viewBox="0 0 24 24"
                                    >
                                        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                                        <path d="M9 18c-4.51 2-5-2-7-2"></path>
                                    </svg>
                                </div>
                                <div>
                                    <h6 class="mb-1 fw-bold social-card-title">
                                        GitHub
                                    </h6>
                                    <span class="social-card-detail">
                                        marcravel
                                    </span>
                                </div>
                            </div>
                        </a>

                        <!-- YouTube Card -->
                        <a
                            href="https://www.youtube.com/@Code-Copper"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-decoration-none social-card-link"
                        >
                            <div class="surface p-3 social-card social-card--4 d-flex align-items-center gap-3">
                                <div class="stamp-icon social-stamp">
                                    <svg
                                        aria-hidden="true"
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="22"
                                        height="22"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        viewBox="0 0 24 24"
                                    >
                                        <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"></path>
                                        <polygon points="10 15 15 12 10 9 10 15"></polygon>
                                    </svg>
                                </div>
                                <div>
                                    <h6 class="mb-1 fw-bold social-card-title">
                                        YouTube
                                    </h6>
                                    <span class="social-card-detail">
                                        Code & Copper
                                    </span>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .form-surface-card {
        background-color: var(--white);
    }

    .form-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--ink);
    }

    .form-feedback-success {
        background-color: var(--p-green);
        border: 2px solid var(--ok);
        color: var(--ink);
        border-radius: var(--radius-s);
        box-shadow: 0 3px 0 0 var(--ok);
        font-weight: 600;
    }

    .form-feedback-error {
        background-color: var(--p-red);
        border: 2px solid var(--danger);
        color: var(--ink);
        border-radius: var(--radius-s);
        box-shadow: 0 3px 0 0 var(--danger);
        font-weight: 600;
    }

    .social-heading {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--ink);
    }

    .social-card {
        background-color: var(--white);
        border: var(--stroke);
        border-radius: var(--radius);
        box-shadow: var(--die), var(--drop);
        transition: transform 160ms var(--spring), box-shadow 160ms var(--ease);
    }

    .social-card--1 { transform: rotate(-0.5deg); }
    .social-card--2 { transform: rotate(0.6deg); }
    .social-card--3 { transform: rotate(-0.4deg); }
    .social-card--4 { transform: rotate(0.5deg); }

    .social-card:hover {
        transform: translateY(-3px) rotate(-1.5deg);
        box-shadow: var(--die), var(--lift);
    }

    .social-stamp {
        color: var(--ink);
    }

    .social-card-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--ink);
    }

    .social-card-detail {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--cta);
        font-weight: 500;
    }
</style>

<script>
    const contactForm = document.getElementById("contactForm");
    const submitButton = document.getElementById("submitButton") as HTMLButtonElement | null;
    const successMessage = document.getElementById("formSuccessMessage");
    const errorMessage = document.getElementById("formErrorMessage");

    if (contactForm && submitButton) {
        contactForm.addEventListener("submit", async function (e) {
            e.preventDefault();

            const originalButtonText = submitButton.innerHTML;
            submitButton.innerHTML = "Sending...";
            submitButton.disabled = true;
            successMessage?.classList.add("d-none");
            errorMessage?.classList.add("d-none");

            const formData = new FormData(contactForm as HTMLFormElement);

            try {
                const response = await fetch(
                    "https://api.web3forms.com/submit",
                    {
                        method: "POST",
                        body: formData,
                    },
                );

                if (response.ok) {
                    (contactForm as HTMLFormElement).reset();
                    successMessage?.classList.remove("d-none");

                    setTimeout(() => {
                        successMessage?.classList.add("d-none");
                    }, 5000);
                } else {
                    console.error("Form submission failed with status", response.status);
                    errorMessage?.classList.remove("d-none");
                }
            } catch (error) {
                console.error("Error submitting form", error);
                errorMessage?.classList.remove("d-none");
            } finally {
                submitButton.innerHTML = originalButtonText;
                submitButton.disabled = false;
            }
        });
    }
</script>
