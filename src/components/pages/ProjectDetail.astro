---
import BaseLayout from "../../layouts/BaseLayout.astro";
import fs from "fs/promises";
import path from "path";
import { useTranslatedPath } from "../../i18n/ui";
import type { Project, Lang } from "../../types/project";
import {
    getOptimizedImagePath,
    normalizeBaseUrl,
} from "../../utils/images";
import { parseProjectCategories } from "../../utils/categories";

export interface Props {
    lang: Lang;
    project: Project;
}
const { lang, project } = Astro.props;
const translatePath = useTranslatedPath(lang);
const baseUrl = normalizeBaseUrl(import.meta.env.BASE_URL);
const developmentStatus = project.developmentStatus?.[lang]?.trim();
const categories = parseProjectCategories(project.category[lang]);

// Helper to determine the hero image URL with BASE_URL routing
let heroImage = project.image;
if (heroImage && !heroImage.startsWith("http")) {
    heroImage = `${baseUrl}${getOptimizedImagePath(heroImage)}`;
}

let descriptionContent = project.longDescription
    ? typeof project.longDescription === "object"
        ? project.longDescription[lang]
        : project.longDescription
    : project.description[lang] || project.description.en;
let isTextFile =
    typeof descriptionContent === "string" &&
    descriptionContent.endsWith(".txt");
if (isTextFile) {
    try {
        const filePath = path.join(
            process.cwd(),
            "public",
            descriptionContent.replace(/^\/+/, ""),
        );
        descriptionContent = await fs.readFile(filePath, "utf-8");
    } catch (err) {
        console.error("Failed to read description file:", err);
        descriptionContent =
            project.description[lang] || project.description.en;
    }
}

const subtitleRegex =
    /^(Project Overview|Role & Responsibilities|System Architecture|Results & Recognition|Aperçu du Projet|Rôle et Responsabilités|Architecture du Système|Résultats et Reconnaissance|Proje Özeti|Rol ve Sorumluluklar|Sistem Mimarisi|Sonuçlar ve Başarılar):?$/i;

const escapeHtml = (value: string) =>
    value.replace(
        /[&<>"']/g,
        (character) =>
            ({
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                '"': "&quot;",
                "'": "&#39;",
            })[character] || character,
    );

const parsedLongDescription = (
    typeof descriptionContent === "string" ? descriptionContent : ""
)
    .split("\n")
    .filter((p) => p.trim() !== "")
    .map((p) => {
        const trimmed = p.trim();
        if (subtitleRegex.test(trimmed)) {
            return `<h3 class="detail-subtitle">${escapeHtml(trimmed)}</h3>`;
        }
        return `<p class="detail-paragraph">${escapeHtml(trimmed)}</p>`;
    })
    .join("");

const t_back = {
    en: "Back to Projects",
    fr: "Retour aux projets",
    tr: "Projelere Dön",
};
const t_tech = {
    en: "Technologies Built With",
    fr: "Technologies Utilisées",
    tr: "Kullanılan Teknolojiler",
};
const t_gallery = { en: "Gallery", fr: "Galerie", tr: "Galeri" };
const t_overview = { en: "Overview", fr: "Aperçu", tr: "Genel Bakış" };
const t_image = {
    en: "project image",
    fr: "image du projet",
    tr: "proje görseli",
};
const t_galleryImage = {
    en: (title: string, index: number, total: number) =>
        `${title} – photo ${index} of ${total}`,
    fr: (title: string, index: number, total: number) =>
        `${title} – photo ${index} sur ${total}`,
    tr: (title: string, index: number, total: number) =>
        `${title} – ${total} fotoğraftan ${index}. fotoğraf`,
};
---

<BaseLayout
    title={`${project.title[lang]} - Marc Projects`}
    description={project.description[lang] || project.description.en}
>
    <!-- Dark Header Section: Back button, Categories, Title, Achievements, Technologies -->
    <header class="page-header-dark">
        <div class="container animate-fade-up">
            <!-- Navigation Back -->
            <div class="mb-4">
                <a
                    href={translatePath("/projects")}
                    class="btn-back-dark"
                >
                    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    <span>{t_back[lang]}</span>
                </a>
            </div>

            <!-- Categories & Status (Left-aligned) -->
            <div class="mb-3 d-flex flex-wrap align-items-center gap-2">
                {categories.map((cat) => (
                    <span
                        class="badge badge-category"
                        style={`background-color: ${cat.bg}; color: ${cat.fg}; border: ${cat.border};`}
                    >
                        {cat.label}
                    </span>
                ))}
                {
                    developmentStatus && (
                        <span class="badge badge-green detail-status-badge">
                            {developmentStatus}
                        </span>
                    )
                }
            </div>

            <!-- Project Title (Left-aligned) -->
            <h1 class="page-title text-start mb-3">
                {project.title[lang]}
            </h1>

            {
                project.achievements && project.achievements[lang] && (
                    <div class="achievements-banner text-start mb-4">
                        <span class="achievements-text">
                            {project.achievements[lang]}
                        </span>
                    </div>
                )
            }

            <!-- Technologies (Left-aligned) -->
            <div class="mt-4">
                <p class="kicker text-start mb-2">
                    <span>{t_tech[lang]}</span>
                </p>
                <div class="d-flex flex-wrap gap-2">
                    {
                        project.techStack.map((tech) => (
                            <span class="tag">
                                {tech}
                            </span>
                        ))
                    }
                </div>
            </div>

            <div class="header-rainbow-line mt-4"></div>
        </div>
    </header>

    <!-- Light Body Section: Gallery, Media Hero & Overview -->
    <section class="page-body-light">
        <div class="container animate-fade-up">
            <div class="grid grid-cols-1 lg-grid-cols-3 gap-5">
                <!-- Gallery Column -->
                <div class="order-2 lg-order-2">
                    {
                        project.gallery && project.gallery.length > 0 && (
                            <div class="surface p-4 sticky-gallery">
                                <p class="kicker mb-2">
                                    <span>{t_gallery[lang]}</span>
                                </p>
                                <h3 class="gallery-heading mb-4">
                                    {t_gallery[lang]}
                                </h3>
                                <div class="grid grid-cols-2 gap-3">
                                    {project.gallery.map((galleryImg, index) => {
                                        let imgPath = galleryImg;
                                        let fullImgPath = galleryImg;
                                        if (!imgPath.startsWith("http")) {
                                            imgPath = `${baseUrl}${getOptimizedImagePath(imgPath, "thumbnail")}`;
                                            fullImgPath = `${baseUrl}${getOptimizedImagePath(fullImgPath)}`;
                                        }
                                        return (
                                            <button
                                                type="button"
                                                aria-label={project.galleryAlt?.[index]?.[lang] ||
                                                    t_galleryImage[lang](
                                                        project.title[lang],
                                                        index + 1,
                                                        project.gallery.length,
                                                    )}
                                                class="gallery-thumbnail-btn"
                                            >
                                                <img
                                                    src={imgPath}
                                                    data-full-src={fullImgPath}
                                                    width="400"
                                                    height="400"
                                                    class="gallery-thumb-img"
                                                    alt={
                                                        project.galleryAlt?.[index]?.[lang] ||
                                                        t_galleryImage[lang](
                                                            project.title[lang],
                                                            index + 1,
                                                            project.gallery.length,
                                                        )
                                                    }
                                                    loading="lazy"
                                                    decoding="async"
                                                />
                                            </button>
                                        );
                                    })}
                                </div>
                            </div>
                        )
                    }
                </div>

                <!-- Right Column: Media Hero & Overview -->
                <div
                    class="lg-grid-col-span-2 order-1 lg-order-1"
                >
                    <!-- Media Hero (YouTube or Image) -->
                    <div class="surface overflow-hidden p-0 mb-4 media-hero-box">
                        {
                            project.youtubeId ? (
                                <div class="video-container">
                                    <iframe
                                        class="video-iframe"
                                        src={`https://www.youtube.com/embed/${project.youtubeId}?rel=0`}
                                        title="Technical hardware overview of the project"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                        allowfullscreen
                                    />
                                </div>
                            ) : (
                                heroImage && (
                                    <img
                                        src={heroImage}
                                        width="1600"
                                        height="1000"
                                        loading="eager"
                                        fetchpriority="high"
                                        decoding="async"
                                        alt={`${project.title[lang]} – ${t_image[lang]}`}
                                        class="w-100 media-hero-img"
                                    />
                                )
                            )
                        }
                    </div>

                    <!-- Long Description -->
                    <div class="surface p-4 p-md-5 overview-card">
                        <p class="kicker mb-1">
                            <span>{t_overview[lang]}</span>
                        </p>
                        <h2 class="overview-title mb-4">
                            {t_overview[lang]}
                        </h2>
                        <div class="project-details">
                            <span set:html={parsedLongDescription} />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Custom Modal -->
    <div
        id="customImageModal"
        class="custom-modal"
        role="dialog"
        aria-modal="true"
        aria-label={t_gallery[lang]}
    >
        <div class="custom-modal-content">
            <button
                type="button"
                class="custom-modal-close"
                aria-label={lang === "en" ? "Close image viewer" : lang === "fr" ? "Fermer la visionneuse d’images" : "Görsel görüntüleyiciyi kapat"}
            >&times;</button>
            <img id="customModalImage" src="" alt="" width="1600" height="1000" />
        </div>
    </div>
</BaseLayout>

<style>
    .project-title {
        font-size: clamp(2rem, 4vw, 3.25rem);
        font-weight: 700;
        letter-spacing: -0.035em;
        line-height: 1.1;
        color: var(--ink);
    }

    .detail-category-badge {
        font-size: 0.875rem;
        padding: 6px 16px;
    }

    .detail-status-badge {
        font-size: 0.875rem;
        padding: 6px 16px;
    }

    .achievements-banner {
        display: inline-block;
        max-width: 100%;
        padding: 12px 20px;
        background-color: var(--p-yellow);
        border: 2px solid var(--white);
        border-radius: var(--radius-s);
        box-shadow: 0 4px 0 0 rgb(0 0 0 / 0.45);
        color: var(--ink);
        font-weight: 600;
        font-size: 0.9375rem;
    }

    .sticky-gallery {
        position: sticky;
        top: calc(var(--appbar-h) + 1.5rem);
        z-index: 10;
    }

    .gallery-heading {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--ink);
    }

    .gallery-thumbnail-btn {
        aspect-ratio: 1;
        padding: 0;
        border: 2px solid var(--ink);
        border-radius: var(--radius-s);
        box-shadow: 0 3px 0 0 var(--ink);
        overflow: hidden;
        background-color: var(--surface-2);
        cursor: pointer;
        display: block;
        width: 100%;
        transition: transform 160ms var(--spring), box-shadow 160ms var(--ease);
    }

    .gallery-thumbnail-btn:hover {
        transform: scale(1.04) rotate(-1deg);
        box-shadow: 0 5px 0 0 var(--ink);
    }

    .gallery-thumb-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .media-hero-box {
        background-color: var(--night);
    }

    .video-container {
        position: relative;
        width: 100%;
        padding-bottom: 56.25%;
    }

    .video-iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
    }

    .media-hero-img {
        object-fit: cover;
        max-height: 520px;
        display: block;
    }

    .overview-card {
        background-color: var(--white);
    }

    .overview-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--ink);
        letter-spacing: -0.025em;
    }

    :global(.detail-subtitle) {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--cta);
        margin-top: 36px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 6px;
        letter-spacing: -0.02em;
    }

    :global(.detail-subtitle::before) {
        content: "{";
        font-family: var(--font);
        font-size: 1.5em;
        line-height: 1;
        color: var(--blue);
        font-weight: 400;
    }

    :global(.detail-subtitle::after) {
        content: "}";
        font-family: var(--font);
        font-size: 1.5em;
        line-height: 1;
        color: var(--blue);
        font-weight: 400;
    }

    :global(.detail-paragraph) {
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--ink-2);
        margin-bottom: 16px;
    }

    /* Custom Modal */
    .custom-modal {
        display: none;
        position: fixed;
        z-index: 9999;
        inset: 0;
        background-color: rgb(31 31 31 / 0.95);
        background-image:
            linear-gradient(to right, var(--night-grid) 1px, transparent 1px),
            linear-gradient(to bottom, var(--night-grid) 1px, transparent 1px);
        background-size: 40px 40px;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 200ms var(--ease);
    }

    .custom-modal.show {
        display: flex;
        opacity: 1;
    }

    .custom-modal-content {
        position: relative;
        max-width: 90%;
        max-height: 90%;
    }

    .custom-modal-content img {
        max-width: 100%;
        max-height: 88vh;
        object-fit: contain;
        border: 3px solid var(--white);
        border-radius: var(--radius);
        box-shadow: 0 16px 48px rgba(0, 0, 0, 0.7);
    }

    .custom-modal-close {
        position: absolute;
        top: -48px;
        right: 0;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 2px solid var(--white);
        background-color: var(--night);
        color: var(--white);
        font-size: 28px;
        line-height: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 0 0 #000;
        cursor: pointer;
        transition: transform 160ms var(--spring), background-color 160ms var(--ease);
    }

    .custom-modal-close:hover {
        background-color: var(--danger);
        transform: translateY(-2px) rotate(90deg);
    }
</style>

<script>
    const galleryButtons = document.querySelectorAll<HTMLButtonElement>(".gallery-thumbnail-btn");
    const modal = document.getElementById("customImageModal");
    const modalImg = document.getElementById("customModalImage") as HTMLImageElement | null;
    const closeBtn = document.querySelector(".custom-modal-close");

    galleryButtons.forEach((btn) => {
        const img = btn.querySelector<HTMLImageElement>("img");
        if (!img) return;

        btn.addEventListener("click", () => {
            if (modal && modalImg) {
                modalImg.src = img.dataset.fullSrc || img.src;
                modalImg.alt = img.alt;
                modal.classList.add("show");
                document.body.style.overflow = "hidden";
            }
        });
    });

    const closeModal = () => {
        if (modal) {
            modal.classList.remove("show");
            document.body.style.overflow = "auto";
        }
    };

    if (closeBtn) closeBtn.addEventListener("click", closeModal);

    if (modal) {
        modal.addEventListener("click", (e) => {
            if (e.target === modal) {
                closeModal();
            }
        });
    }

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && modal?.classList.contains("show")) {
            closeModal();
        }
    });
</script>
