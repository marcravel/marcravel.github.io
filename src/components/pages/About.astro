const t = { ...texts[lang], ...aboutContent[lang] };
const items = t.timeline ?? [];
---

<BaseLayout title={t.title} description={t.description}>
<div class="about-page">
    <section class="section">
        <div class="container animate-fade-up">
            <h1 class="section-title"><span>{t.h1}</span></h1>
            <div>
                <img
                    src={profileImage.src}
                    alt="Marc"
                    style="display: block; width: 300px; height: 300px; margin: 0 auto calc(var(--section-gap) / 2); object-fit: cover; border-radius: 50%;
                    padding: 0.25rem;"
                />
            </div>

            <div class="grid grid-cols-1 md-grid-cols-2 lg-grid-cols-3 gap-3 about-columns">
                <!-- Professional Summary -->
                <div class="surface p-4 p-md-5 about-summary">
                    <h3 class="mb-4" style="color: var(--color-accent-1); font-size: 1.5rem;">
                        {t.profSummary}
                    </h3>
                    <p class="lead" style="color: var(--color-text-secondary); font-size: 1.1rem; line-height: 1.8;">
                        {t.bioText}
                    </p>
                </div>


                <!-- Technical Skills Matrix -->
                <div class="surface p-4 p-md-5 about-skills">
                    <h3
                        class="mb-4"     
                        style="color: var(--color-deep); font-size: 1.5rem;"
                    >
                        {t.techMatrix}
                    </h3>

                    <div class="mb-4">
                        <h5
                            class="text-uppercase mb-3 small fw-bold"
                            style="color: var(--color-text-secondary); letter-spacing: 1px;"
                        >
                            {t.hwEmb}
                        </h5>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge px-3 py-2" set:html={t.skillItems.embedded[0]}></span>
                            <span class="badge px-3 py-2" set:html={t.skillItems.embedded[1]}></span>
                            <span class="badge px-3 py-2" set:html={t.skillItems.embedded[2]}></span>
                            <span class="badge px-3 py-2" set:html={t.skillItems.embedded[3]}></span>
                            <span class="badge px-3 py-2" set:html={t.skillItems.embedded[4]}></span>
                            <span class="badge px-3 py-2" set:html={t.skillItems.embedded[5]}></span>
                            <span class="badge px-3 py-2" set:html={t.skillItems.embedded[6]}></span>
                            <span class="badge px-3 py-2" set:html={t.skillItems.embedded[7]}></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h5
                            class="text-uppercase mb-3 small fw-bold"
                            style="color: var(--color-text-secondary); letter-spacing: 1px;"
                        >
                            {t.softAi}
                        </h5>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge px-3 py-2" style="border-color: var(--color-border); color: var(--color-text-secondary);" set:html={t.skillItems.control[0]}></span>
                            <span class="badge px-3 py-2" style="border-color: var(--color-border); color: var(--color-text-secondary);" set:html={t.skillItems.control[1]}></span>
                            <span class="badge px-3 py-2" style="border-color: var(--color-border); color: var(--color-text-secondary);" set:html={t.skillItems.control[2]}></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h5
                            class="text-uppercase mb-3 small fw-bold"
                            style="color: var(--color-text-secondary); letter-spacing: 1px;"
                        >
                            {t.toolsMulti}
                        </h5>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge px-3 py-2" style="border-color: var(--color-border); color: var(--color-text-primary);" set:html={t.skillItems.tools[0]}></span>
                            <span class="badge px-3 py-2" style="border-color: var(--color-border); color: var(--color-text-primary);" set:html={t.skillItems.tools[1]}></span>
                            <span class="badge px-3 py-2" style="border-color: var(--color-border); color: var(--color-text-primary);" set:html={t.skillItems.tools[2]}></span>
                            <span class="badge px-3 py-2" style="border-color: var(--color-border); color: var(--color-text-primary);" set:html={t.skillItems.tools[3]}></span>
                            <span class="badge px-3 py-2" style="border-color: var(--color-border); color: var(--color-text-primary);" set:html={t.skillItems.tools[4]}></span>
                            <span class="badge px-3 py-2" style="border-color: var(--color-border); color: var(--color-text-primary);" set:html={t.skillItems.tools[5]}></span>
