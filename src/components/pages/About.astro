                        </p>
                    </div>
                </div>
                <!-- Languages -->
                    <div class="surface p-4 p-md-5 about-languages">
                        <h3
                            class="mb-4"
                            style="color: var(--color-deep); font-size: 1.5rem;"
                        >
                            {t.languages}
                        </h3>
                        <div class="d-flex flex-column gap-3">
                            <div
                                class="d-flex align-items-center justify-content-between"
                            >
                                <strong
                                    style="color: var(--color-text-primary);"
                                    >{t.spokenLanguages[0].name}</strong
                                >
                                <div
                                    style="flex-grow: 1; border-bottom: 1px dashed var(--color-border); margin: 0 1rem;"
                                >
                                </div>
                                <span
                                    style="color: var(--color-text-secondary);"
                                    >{t.spokenLanguages[0].level}</span
                                >
                            </div>
                            <div
                                class="d-flex align-items-center justify-content-between"
                            >
                                <strong
                                    style="color: var(--color-text-primary);"
                                    >{t.spokenLanguages[1].name}</strong
                                >
                                <div
                                    style="flex-grow: 1; border-bottom: 1px dashed var(--color-border); margin: 0 1rem;"
                                >
                                </div>
                                <span
                                    style="color: var(--color-text-secondary);"
                                    >{t.spokenLanguages[1].level}</span
                                >
                            </div>
                            <div
                                class="d-flex align-items-center justify-content-between"
                            >
                                <strong
                                    style="color: var(--color-text-primary);"
                                    >{t.spokenLanguages[2].name}</strong
                                >
                                <div
                                    style="flex-grow: 1; border-bottom: 1px dashed var(--color-border); margin: 0 1rem;"
                                >
                                </div>
                                <span
                                    style="color: var(--color-text-secondary);"
                                    >{t.spokenLanguages[2].level}</span
                                >
                            </div>
                            <div
                                class="d-flex align-items-center justify-content-between"
                            >
                                <strong
                                    style="color: var(--color-text-primary);"
                                    >{t.spokenLanguages[3].name}</strong
                                >
                                <div
                                    style="flex-grow: 1; border-bottom: 1px dashed var(--color-border); margin: 0 1rem;"
                                >
                                </div>
                                <span
                                    style="color: var(--color-text-secondary);"
                                    >{t.spokenLanguages[3].level}</span
                                >
                            </div>
                            <div
                                class="d-flex align-items-center justify-content-between"
                            >
                                <strong
                                    style="color: var(--color-text-primary);"
                                    >{t.spokenLanguages[4].name}</strong
                                >
                                <div
                                    style="flex-grow: 1; border-bottom: 1px dashed var(--color-border); margin: 0 1rem;"
                                >
                                </div>
                                <span
                                    style="color: var(--color-text-secondary);"
                                    >{t.spokenLanguages[4].level}</span
                                >
                            </div>
                        </div>
                    </div>

            </div>
    </section>

    {items.length > 0 && (
        <section class="section">
            <div class="container animate-fade-up">
                <h2 class="mb-4" style="color: var(--color-deep); font-size: 1.5rem;">
                    {t.timelineTitle}
                </h2>
                <div class="timeline-wrap">
                    <div class="timeline-scroll">
                        <ol class="timeline">
                            {items.map((item, index) => (
                                <li class={`timeline-item ${index % 2 === 0 ? "is-top" : "is-bottom"} ${item.current ? "is-current" : ""}`}>
                                    <div class="surface p-4 timeline-card">
                                        <span class="timeline-year">{item.year}</span>
                                        <h5 class="fw-bold mb-2" style="color: var(--color-text-primary);">
                                            {item.title}
                                        </h5>
                                        <p class="small mb-0" style="color: var(--color-text-secondary);">
                                            {item.desc}
                                        </p>
                                    </div>
                                    <div class="timeline-mid">
                                        <span class="timeline-dot"></span>
                                    </div>
                                </li>
                            ))}
                        </ol>
                    </div>
                </div>
            </div>
        </section>
    )}
    
</div>
</BaseLayout>

<style is:global>
    .about-page .section {
        padding-block: var(--section-gap);
    }

    .about-page .section + .section {
        padding-top: 0;
    }

    .about-page .section-title {
        margin-bottom: calc(var(--section-gap) / 2);
    }

    .about-page .grid {
        gap: 1rem;
    }

    .about-page .surface > :last-child,
    .about-page .edu-card > :last-child {
        margin-bottom: 0;
    }

    /* Hover Effects for Cards matching ProjectCards */
    .edu-card {
        transition:
            transform 0.3s ease,
            border-color 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .edu-card:hover {
        transform: translateY(-5px);
        border-color: var(--color-accent-1);
    }

    .ps-3 {
        padding-left: 1rem;
    }

    .course-link {
        color: inherit;
    }

    .cert-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(7, 50, 106, 0.92);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: all 0.3s ease;
        z-index: 10;
    }

    .cert-btn {
        background: var(--color-accent-1);
        color: var(--color-light);
        padding: 0.6rem 1.2rem;
        border-radius: var(--radius-pill);
        font-weight: 600;
        font-size: 0.95rem;
        transform: translateY(15px);
        transition: all 0.3s ease;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    }

    .course-link:hover .cert-overlay {
        opacity: 1;
    }

    .course-link:hover .cert-btn {
        transform: translateY(0);
    }
    .timeline-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 1rem;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
}

.timeline {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 280px;
    grid-template-rows: auto auto auto; /* above | line | below */
    column-gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0 1.5rem;          /* room so the edge fades don't hide the first/last card */
    box-sizing: border-box;
    width: max-content;
    min-width: 100%;
}

.timeline-item {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
}

/* middle row: line + dot + stem */
.timeline-mid {
    grid-row: 2;
    position: relative;
    height: 3rem;
    display: flex;
    align-items: center;
}

/* the line, bridging the gap to the next item */
.timeline-mid::before {
    content: "";
    position: absolute;
    left: 0;
    right: -1.5rem;
    top: 50%;
    height: 2px;
    transform: translateY(-50%);
    background: var(--color-border);
}
.timeline-item:last-child .timeline-mid::before {
    right: 0;
}

/* stem from the dot to the card */
.timeline-mid::after {
    content: "";
    position: absolute;
    left: 1.5rem;
    width: 2px;
    height: 1.5rem;
    transform: translateX(-50%);
    background: var(--color-accent-1);
    opacity: 0.5;
}
.is-top .timeline-mid::after    { bottom: 50%; }
.is-bottom .timeline-mid::after { top: 50%; }

.timeline-dot {
    position: relative;
    z-index: 1;
    margin-left: 1.5rem;        /* aligns the dot with the stem */
    transform: translateX(-50%);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-accent-1);
    box-shadow: 0 0 0 4px var(--color-bg-elevated), 0 0 0 5px var(--color-accent-1);
}

/* year pill */
.timeline-year {
    display: inline-block;
    margin-bottom: 0.5rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.5px;
    color: var(--color-accent-1);
}

/* cards: alternate above / below */
.timeline-card {
    border-top: 2px solid transparent;
    transition: transform 0.2s ease, border-color 0.2s ease;
}
.is-top .timeline-card {
    grid-row: 1;
    align-self: end;
}
.is-bottom .timeline-card {
    grid-row: 3;
    align-self: start;
}

/* hover lift */
.timeline-item:hover .timeline-card {
    transform: translateY(-4px);
    border-top-color: var(--color-accent-1);
}
.is-bottom:hover .timeline-card {
    transform: translateY(4px);
}

/* current item (pulsing dot + accent border) */
.is-current .timeline-card { border-top-color: var(--color-accent-1); }
.is-current .timeline-dot  { animation: tl-pulse 2s infinite; }

.timeline-wrap {
    position: relative;
}
.timeline-wrap::before,
.timeline-wrap::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 1rem;               /* stop above the scrollbar */
    width: 2.5rem;
    pointer-events: none;       /* don't block scrolling or clicks */
    z-index: 2;
}
.timeline-wrap::before {
    left: 0;
    background: linear-gradient(to right, var(--color-bg), transparent);
}
.timeline-wrap::after {
    right: 0;
    background: linear-gradient(to left, var(--color-bg), transparent);
}

@media (max-width: 767px) {
    .timeline-wrap::before,
    .timeline-wrap::after { display: none; }
}

@keyframes tl-pulse {
    0%   { box-shadow: 0 0 0 4px var(--color-bg-elevated), 0 0 0 5px var(--color-accent-1), 0 0 0 5px transparent; }
    70%  { box-shadow: 0 0 0 4px var(--color-bg-elevated), 0 0 0 5px var(--color-accent-1), 0 0 0 14px rgba(128,128,128,0.15); }
    100% { box-shadow: 0 0 0 4px var(--color-bg-elevated), 0 0 0 5px var(--color-accent-1), 0 0 0 5px transparent; }
}

@media (prefers-reduced-motion: reduce) {
    .is-current .timeline-dot { animation: none; }
    .timeline-card { transition: none; }
}

/* phones: vertical list, no alternating */
@media (max-width: 767px) {
    .timeline {
        display: flex;
        flex-direction: column;
        width: auto;
        padding: 0;
        gap: 1rem;
    }
    .timeline-item { display: block; }
    .timeline-mid { display: none; }
    .timeline-item:hover .timeline-card,
    .is-bottom:hover .timeline-card { transform: none; }
}
</style>

<script>
    const scroller = document.querySelector<HTMLElement>(".timeline-scroll");

    if (scroller) {
        let lastWheel = 0;

        scroller.addEventListener(
            "wheel",
            (e) => {
                if (scroller.scrollWidth <= scroller.clientWidth) return;
                if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;

                const now = Date.now();
                const idle = now - lastWheel > 400;
                lastWheel = now;

                const atStart = scroller.scrollLeft <= 0;
                const atEnd =
                    scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 1;
                const pushingPastEdge =
                    (e.deltaY < 0 && atStart) || (e.deltaY > 0 && atEnd);

                if (pushingPastEdge && idle) return;

                e.preventDefault();
                scroller.scrollLeft += e.deltaY;
            },
            { passive: false }
        );
    }
</script>