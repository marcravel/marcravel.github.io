---

<BaseLayout title={t.title} description={t.description}>
    <section class="section">
        <div class="container animate-fade-up">
            <h1 class="section-title"><span>{t.h1}</span></h1>

            <div class="grid grid-cols-1 md-grid-cols-2 lg-grid-cols-2 gap-5">
                <!-- Left Column: Bio & Skills -->
                <div>
                    <!-- Professional Summary -->
                    <div class="glass p-4 p-md-5 mb-5">
                        <h3
                            class="mb-3"
                            style="color: var(--color-accent-1); font-size: 1.5rem;"
                        >
                            {t.profSummary}
                        </h3>
                        <p
                            class="lead"
                            style="color: var(--color-text-secondary); font-size: 1.1rem; line-height: 1.8;"
                        >
                            {t.profDesc}
                        </p>
                    </div>

                    <!-- Technical Skills Matrix -->
                    <div class="glass p-4 p-md-5 mb-5">
                        <h3
                            class="mb-4"
                            style="color: var(--color-accent-2); font-size: 1.5rem;"
                        >
                            {t.techMatrix}
                        </h3>

                        <div class="mb-4">
                            <h5
                                class="text-uppercase mb-3 small fw-bold"
                                style="color: var(--color-text-secondary); letter-spacing: 1px;"
                            >
                                {t.hwEmb}
                            </h5>
                            <div class="d-flex flex-wrap gap-2">
                                <span class="badge px-3 py-2">C/C++</span>
                                <span class="badge px-3 py-2">PIC</span>
                                <span class="badge px-3 py-2">STM32</span>
                                <span class="badge px-3 py-2">ESP32</span>
                                <span class="badge px-3 py-2">Arduino</span>
                                <span class="badge px-3 py-2">PCB Design</span>
                                <span class="badge px-3 py-2"
                                    >Circuit Design</span
                                >
                                <span class="badge px-3 py-2">Altium</span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <h5
                                class="text-uppercase mb-3 small fw-bold"
                                style="color: var(--color-text-secondary); letter-spacing: 1px;"
                            >
                                {t.softAi}
                            </h5>
                            <div class="d-flex flex-wrap gap-2">
                                <span
                                    class="badge px-3 py-2"
                                    style="border-color: rgba(59, 130, 246, 0.5); color: #60a5fa;"
                                    >Fuzzy Logic</span
                                >
                                <span
                                    class="badge px-3 py-2"
                                    style="border-color: rgba(59, 130, 246, 0.5); color: #60a5fa;"
                                    >Digital Control Loops</span
                                >
                                <span
                                    class="badge px-3 py-2"
                                    style="border-color: rgba(59, 130, 246, 0.5); color: #60a5fa;"
                                    >Sensors & Actuators</span
                                >
                            </div>
                        </div>

                        <div class="mb-4">
                            <h5
                                class="text-uppercase mb-3 small fw-bold"
                                style="color: var(--color-text-secondary); letter-spacing: 1px;"
                            >
                                {t.toolsMulti}
                            </h5>
                            <div class="d-flex flex-wrap gap-2">
                                <span
                                    class="badge px-3 py-2"
                                    style="border-color: rgba(139, 92, 246, 0.5); color: #c084fc;"
                                    >Git</span
                                >
                                <span
                                    class="badge px-3 py-2"
                                    style="border-color: rgba(139, 92, 246, 0.5); color: #c084fc;"
                                    >HTML/CSS/JS</span
                                >
                                <span
                                    class="badge px-3 py-2"
                                    style="border-color: rgba(139, 92, 246, 0.5); color: #c084fc;"
                                    >Linux</span
                                >
                                <span
                                    class="badge px-3 py-2"
                                    style="border-color: rgba(139, 92, 246, 0.5); color: #c084fc;"
                                    >Python</span
                                >
                                <span
                                    class="badge px-3 py-2"
                                    style="border-color: rgba(139, 92, 246, 0.5); color: #c084fc;"
                                    >Serial & Device Interfaces</span
                                >
                                <span
                                    class="badge px-3 py-2"
                                    style="border-color: rgba(139, 92, 246, 0.5); color: #c084fc;"
                                    >Video Editing</span
                                >
                                <span
                                    class="badge px-3 py-2"
                                    style="border-color: rgba(139, 92, 246, 0.5); color: #c084fc;"
                                    >YouTube "Code & Copper" Management</span
                                >
                            </div>
                        </div>

                        <div>
                            <h5
                                class="text-uppercase mb-3 small fw-bold"
                                style="color: var(--color-text-secondary); letter-spacing: 1px;"
                            >
                                {t.supportingSoftware}
                            </h5>
                            <p class="small text-muted mb-0">
                                {t.supportingSoftwareDesc}
                            </p>
                        </div>
                    </div>

                    <!-- Languages -->
                    <div class="glass p-4 p-md-5 mb-5">
                        <h3
                            class="mb-4"
                            style="color: var(--color-accent-1); font-size: 1.5rem;"
                        >
                            {t.languages}
                        </h3>
                        <div class="d-flex flex-column gap-3">
                            <div
                                class="d-flex align-items-center justify-content-between"
                            >
                                <strong
                                    style="color: var(--color-text-primary);"
                                    >English</strong
                                >
                                <div
                                    style="flex-grow: 1; border-bottom: 1px dashed rgba(255,255,255,0.1); margin: 0 1rem;"
                                >
                                </div>
                                <span
                                    style="color: var(--color-text-secondary);"
                                    >{t.langLvl.pro}</span
                                >
                            </div>
                            <div
                                class="d-flex align-items-center justify-content-between"
                            >
                                <strong
                                    style="color: var(--color-text-primary);"
                                    >French</strong
                                >
                                <div
                                    style="flex-grow: 1; border-bottom: 1px dashed rgba(255,255,255,0.1); margin: 0 1rem;"
                                >
                                </div>
                                <span
                                    style="color: var(--color-text-secondary);"
                                    >{t.langLvl.fluent}</span
                                >
                            </div>
                            <div
                                class="d-flex align-items-center justify-content-between"
                            >
                                <strong
                                    style="color: var(--color-text-primary);"
                                    >Turkish</strong
                                >
                                <div
                                    style="flex-grow: 1; border-bottom: 1px dashed rgba(255,255,255,0.1); margin: 0 1rem;"
                                >
                                </div>
                                <span
                                    style="color: var(--color-text-secondary);"
                                    >{t.langLvl.fluent}</span
                                >
                            </div>
                            <div
                                class="d-flex align-items-center justify-content-between"
                            >
                                <strong
                                    style="color: var(--color-text-primary);"
                                    >German</strong
                                >
                                <div
                                    style="flex-grow: 1; border-bottom: 1px dashed rgba(255,255,255,0.1); margin: 0 1rem;"
                                >
                                </div>
                                <span
                                    style="color: var(--color-text-secondary);"
                                    >A1</span
                                >
                            </div>
                            <div
                                class="d-flex align-items-center justify-content-between"
                            >
                                <strong
                                    style="color: var(--color-text-primary);"
                                    >Malagasy</strong
                                >
                                <div
                                    style="flex-grow: 1; border-bottom: 1px dashed rgba(255,255,255,0.1); margin: 0 1rem;"
                                >
                                </div>
                                <span
                                    style="color: var(--color-text-secondary);"
                                    >{t.langLvl.native}</span
                                >
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Education & Experience -->
                <div>
                    <h3
                        class="mb-4"
                        style="color: var(--color-accent-2); font-size: 1.5rem;"
                    >
                        {t.eduHonors}
                    </h3>

                    <!-- Education Card 1 -->
                    <div class="glass p-4 mb-4 edu-card">
                        <h5
                            class="fw-bold mb-2"
                            style="color: var(--color-text-primary);"
                        >
                            {t.edu1.title}
                        </h5>
                        <p
                            class="mb-2 small fw-bold"
                            style="color: var(--color-accent-1);"
                        >
                            {t.edu1.year}
                        </p>
                        <p
                            class="small mb-3"
                            style="color: var(--color-text-secondary);"
                        >
                            {t.edu1.loc}
                        </p>
                        {showScholarship && (
                            <div class="mt-2">
                                <span
                                    class="badge px-3 py-2"
                                    style="background: rgba(59, 130, 246, 0.1); color: #60a5fa; border-color: rgba(59, 130, 246, 0.3);"
                                    >{t.edu1.badge}</span
                                >
                            </div>
                        )}
                    </div>

                    <!-- Education Card 2 -->
                    <div class="glass p-4 mb-5 edu-card">
                        <h5
                            class="fw-bold mb-2"
