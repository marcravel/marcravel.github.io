---
import BaseLayout from "../../layouts/BaseLayout.astro";
import aboutContent from "../../data/about.json";
import profileImage from "../../assets/profile.jpeg";

export interface Props {
    lang: "en" | "fr" | "tr";
}
const { lang } = Astro.props;

const texts = {
    en: {
        title: "About - Marc",
        description:
            "Learn about Marc, a final-year Electrical-Electronics Engineering student focused on embedded firmware, electronics, PCB design, and control.",
        kicker: "Profile & Background",
        h1: "About Me",
        profSummary: "Professional Summary",
        techMatrix: "Skills",
        hwEmb: "Embedded Firmware",
        softAi: "Control",
        toolsMulti: "Tools & Multimedia",
        supportingSoftware: "Supporting Software",
        supportingSoftwareDesc: "Familiar with ML fundamentals and OpenCV",
        languages: "Languages",
        eduHonors: "Education",
        experience: "Experiences",
        courses: "Courses",
        certTitle: "View Certificate",
        community: "Community Involvement",
        timelineKicker: "Career Trajectory",
        timelineTitle: "Timeline",
        timeline: [
            { year: "2021", title: "High School Diploma (Scientific)", desc: "Lycée Privé Saint Joseph, Antsirabe. Magna Cum Laude." },
            { year: "2021 – 2022", title: "Programmer and Robotics Trainee", desc: "ITRAS Group, Antananarivo. Path-planning algorithms, microcontroller boards, maze-solving and line-following robots." },
            { year: "2023", title: "Started Electrical-Electronics Engineering", desc: "Selçuk Üniversitesi, Konya. Turkish Government Scholarship awardee." },
            { year: "Dec 2025", title: "Multimedia Coordinator & Graphic Designer", desc: "Malagasy Culture and Solidarity Association in Turkey and Afrokonya." },
            { year: "Jun – Aug 2026", title: "Data Science & Software Development Intern", desc: "Autodidactic Technologies, Istanbul. Crop-disease image classification (ResNet-18) with a FastAPI serving layer." },
            { year: "Sep 2026 – Jan 2027", current: true, title: "Erasmus+ Exchange", desc: "Riga Technical University, Latvia." },
            { year: "2027", title: "Curricular Internship & Graduation", desc: "Looking for an embedded systems role in the EU." },
        ],
    },
    fr: {
        title: "À propos - Marc",
        description:
            "Découvrez Marc, étudiant en dernière année de génie électrique et électronique, spécialisé en firmware embarqué, électronique, conception de circuits imprimés et contrôle.",
        kicker: "Profil & Parcours",
        h1: "À propos de moi",
        profSummary: "Résumé Professionnel",
        techMatrix: "Compétences",
        hwEmb: "Firmware embarqué",
        softAi: "Contrôle",
        toolsMulti: "Outils & Multimédia",
        supportingSoftware: "Logiciels complémentaires",
        supportingSoftwareDesc: "Connaissances des fondamentaux du ML et d'OpenCV",
        languages: "Langues",
        eduHonors: "Éducation",
        experience: "Expériences",
        courses: "Cours",
        certTitle: "Voir le certificat",
        community: "Engagement Communautaire",
        timelineKicker: "Trajectoire",
        timelineTitle: "Parcours",
        timeline: [
            { year: "2021", title: "Baccalauréat scientifique", desc: "Lycée Privé Saint Joseph, Antsirabe. Mention Bien." },
            { year: "2021 – 2022", title: "Programmeur et stagiaire en robotique", desc: "ITRAS Group, Antananarivo. Algorithmes de planification de trajectoire, cartes à microcontrôleur, robots suiveurs de ligne et résolveurs de labyrinthe." },
            { year: "2023", title: "Début du génie électrique et électronique", desc: "Selçuk Üniversitesi, Konya. Boursier du gouvernement turc." },
            { year: "Déc. 2025", title: "Coordinateur multimédia et graphiste", desc: "Association malgache de culture et de solidarité en Turquie et Afrokonya." },
            { year: "Juin – août 2026", title: "Stagiaire en science des données et développement logiciel", desc: "Autodidactic Technologies, Istanbul. Classification d'images de maladies des cultures (ResNet-18) avec une couche de service FastAPI." },
            { year: "Sept. 2026 – janv. 2027", title: "Échange Erasmus+", desc: "Riga Technical University, Lettonie." },
            { year: "2027", title: "Stage de fin d'études et diplôme", desc: "Recherche d'un poste en systèmes embarqués dans l'UE." },
        ],
    },
    tr: {
        title: "Hakkımda - Marc",
        description:
            "Gömülü firmware, elektronik, PCB tasarımı ve kontrole odaklanan son sınıf Elektrik-Elektronik Mühendisliği öğrencisi Marc hakkında bilgi edinin.",
        kicker: "Profil ve Geçmiş",
        h1: "Hakkımda",
        profSummary: "Profesyonel Özet",
        techMatrix: "Yetenekler",
        hwEmb: "Gömülü Firmware",
        softAi: "Kontrol",
        toolsMulti: "Araçlar ve Multimedya",
        supportingSoftware: "Destekleyici Yazılım",
        supportingSoftwareDesc: "ML temelleri ve OpenCV hakkında bilgi sahibi",
        languages: "Diller",
        eduHonors: "Eğitim",
        experience: "Deneyimler",
        courses: "Kurslar",
        certTitle: "Sertifikayı Görüntüle",
        community: "Topluluk Katılımı",
        timelineKicker: "Kariyer Gelişimi",
        timelineTitle: "Zaman Çizelgesi",
        timeline: [
            { year: "2021", title: "Lise Diploması (Fen)", desc: "Lycée Privé Saint Joseph, Antsirabe. Pekiyi derece (Magna Cum Laude)." },
            { year: "2021 – 2022", title: "Programcı ve Robotik Stajyeri", desc: "ITRAS Group, Antananarivo. Yol planlama algoritmaları, mikrodenetleyici kartları, labirent çözen ve çizgi izleyen robotlar." },
            { year: "2023", title: "Elektrik-Elektronik Mühendisliğine başlangıç", desc: "Selçuk Üniversitesi, Konya. Türkiye Bursları sahibi." },
            { year: "Ara 2025", title: "Multimedya Koordinatörü ve Grafik Tasarımcı", desc: "Türkiye'deki Madagaskar Kültür ve Dayanışma Derneği ve Afrokonya." },
            { year: "Haz – Ağu 2026", title: "Veri Bilimi ve Yazılım Geliştirme Stajyeri", desc: "Autodidactic Technologies, İstanbul. Bitki hastalığı görüntü sınıflandırma (ResNet-18) ve FastAPI servis katmanı." },
            { year: "Eyl 2026 – Oca 2027", title: "Erasmus+ Değişim Programı", desc: "Riga Technical University, Letonya." },
            { year: "2027", title: "Zorunlu Staj ve Mezuniyet", desc: "AB'de gömülü sistemler alanında staj arıyorum." },
        ],
    },
};

const t = { ...texts[lang], ...aboutContent[lang] };
const items = t.timeline ?? [];
---

<BaseLayout title={t.title} description={t.description}>
<div class="about-page">
    <!-- Dark Header Section with left-aligned title & kicker -->
    <header class="page-header-dark">
        <div class="container animate-fade-up">
            <div class="grid grid-cols-1 lg-grid-cols-3 gap-4 align-items-center">
                <div class="lg-grid-col-span-2">
                    <p class="kicker mb-2">
                        <span>{t.kicker}</span>
                    </p>
                    <h1 class="page-title text-start mb-3">
                        {t.h1}
                    </h1>
                    <p class="page-subtitle text-start mb-0" style="max-width: 58ch;">
                        {t.description}
                    </p>
                    <div class="header-rainbow-line"></div>
                </div>
                <div class="profile-image-wrap d-flex justify-content-center justify-content-lg-end">
                    <img
                        src={profileImage.src}
                        alt="Marc"
                        class="profile-image"
                        width="200"
                        height="200"
                    />
                </div>
            </div>
        </div>
    </header>

    <!-- Light Body Section for page content -->
    <section class="page-body-light">
        <div class="container animate-fade-up">
            <div class="grid grid-cols-1 md-grid-cols-2 lg-grid-cols-3 gap-4 about-columns">
                <!-- Professional Summary -->
                <div class="surface p-4 p-md-5 about-card about-card--summary">
                    <p class="kicker mb-1">
                        <span>Background</span>
                    </p>
                    <h3 class="about-card-title mb-4">
                        {t.profSummary}
                    </h3>
                    <p class="lead about-bio">
                        {t.bioText}
                    </p>
                </div>

                <!-- Technical Skills Matrix -->
                <div class="surface p-4 p-md-5 about-card about-card--skills">
                    <p class="kicker mb-1">
                        <span>Expertise</span>
                    </p>
                    <h3 class="about-card-title mb-4">
                        {t.techMatrix}
                    </h3>

                    <div class="mb-4">
                        <h5 class="skill-group-title mb-3">
                            {t.hwEmb}
                        </h5>
                        <div class="d-flex flex-wrap gap-2">
                            {
                                t.skillItems.embedded.map((item: string) => (
                                    <span class="tag" set:html={item}></span>
                                ))
                            }
                        </div>
                    </div>

                    <div class="mb-4">
                        <h5 class="skill-group-title mb-3">
                            {t.softAi}
                        </h5>
                        <div class="d-flex flex-wrap gap-2">
                            {
                                t.skillItems.control.map((item: string) => (
                                    <span class="tag" set:html={item}></span>
                                ))
                            }
                        </div>
                    </div>

                    <div class="mb-4">
                        <h5 class="skill-group-title mb-3">
                            {t.toolsMulti}
                        </h5>
                        <div class="d-flex flex-wrap gap-2">
                            {
                                t.skillItems.tools.map((item: string) => (
                                    <span class="tag" set:html={item}></span>
                                ))
                            }
                        </div>
                    </div>

                    <div class="supporting-software-box p-3">
                        <h5 class="fw-bold mb-1 small">
                            {t.supportingSoftware}
                        </h5>
                        <p class="small text-secondary mb-0">
                            {t.supportingSoftwareDesc}
                        </p>
                    </div>
                </div>

                <!-- Languages -->
                <div class="surface p-4 p-md-5 about-card about-card--languages">
                    <p class="kicker mb-1">
                        <span>Communication</span>
                    </p>
                    <h3 class="about-card-title mb-4">
                        {t.languages}
                    </h3>
                    <div class="d-flex flex-column gap-3">
                        {
                            t.spokenLanguages.map((langItem: { name: string; level: string }) => (
                                <div class="d-flex align-items-center justify-content-between language-row">
                                    <strong class="language-name">{langItem.name}</strong>
                                    <div class="language-rule"></div>
                                    <span class="badge badge-language">{langItem.level}</span>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>

            <!-- Timeline Section -->
            {items.length > 0 && (
                <div class="timeline-section">
                    <div class="text-start mb-5">
                        <p class="kicker mb-2">
                            <span>{t.timelineKicker}</span>
                        </p>
                        <h2 class="section-title text-start mb-0">
                            <span>{t.timelineTitle}</span>
                        </h2>
                    </div>

                    <div class="timeline-wrap">
                        <div class="timeline-scroll">
                            <ol class="timeline">
                                {items.map((item, index) => (
                                    <li class={`timeline-item ${index % 2 === 0 ? "is-top" : "is-bottom"} ${item.current ? "is-current" : ""}`}>
                                        <div class="surface timeline-card">
                                            <span class="badge badge-yellow timeline-year">{item.year}</span>
                                            <h5 class="fw-bold mb-2 timeline-item-title">
                                                {item.title}
                                            </h5>
                                            <p class="small mb-0 text-secondary timeline-item-desc">
                                                {item.desc}
                                            </p>
                                        </div>
                                        <div class="timeline-mid">
                                            <span class="timeline-dot"></span>
                                        </div>
                                    </li>
                                ))}
                            </ol>
                        </div>
                    </div>
                </div>
            )}
        </div>
    </section>
</div>
</BaseLayout>

<style>
    .profile-image-wrap {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .profile-image {
        width: 250px;
        height: 250px;
        border-radius: 50%;
        border: 4px solid var(--white);
        box-shadow: 0 4px 0 0 rgb(0 0 0 / 0.5), var(--drop);
        object-fit: cover;
        display: block;
        background-color: var(--white);
        padding: 4px;
        transition: transform 160ms var(--spring), box-shadow 160ms var(--ease);
    }

    .profile-image:hover {
        transform: scale(1.04) rotate(-2deg);
        box-shadow: 0 8px 0 0 rgb(0 0 0 / 0.6);
    }

    /* Bento Cards Resting Rotations */
    .about-card {
        transition: transform 160ms var(--spring), box-shadow 160ms var(--ease);
    }

    .about-card--summary {
        transform: rotate(-0.5deg);
    }

    .about-card--skills {
        transform: rotate(0.6deg);
    }

    .about-card--languages {
        transform: rotate(-0.4deg);
    }

    .about-card:hover {
        transform: translateY(-4px) rotate(0deg);
        box-shadow: var(--die), var(--lift);
    }

    .about-card-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--ink);
        letter-spacing: -0.025em;
    }

    .about-bio {
        font-size: 1.0625rem;
        line-height: 1.75;
        color: var(--ink-2);
    }

    .skill-group-title {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--cta);
    }

    .supporting-software-box {
        background-color: var(--surface-2);
        border: 1.5px solid var(--ink);
        border-radius: var(--radius-s);
    }

    .language-row {
        width: 100%;
    }

    .language-name {
        color: var(--ink);
        font-weight: 700;
        font-size: 0.9375rem;
    }

    .language-rule {
        flex-grow: 1;
        border-bottom: 2px dashed var(--outline);
        margin: 0 1rem;
    }

    .badge-language {
        background-color: var(--surface-2);
        border: 1.5px solid var(--ink);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--ink);
    }

    /* ---------- Timeline ---------- */
    .timeline-section {
        margin-top: clamp(48px, 8vw, 96px);
    }

    .timeline-wrap {
        position: relative;
    }

    .timeline-scroll {
        overflow-x: auto;
        overflow-y: hidden;
        padding-bottom: 1.5rem;
        scrollbar-width: thin;
        scrollbar-color: var(--ink) transparent;
    }

    .timeline {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: 290px;
        grid-template-rows: auto auto auto;
        column-gap: 1.5rem;
        list-style: none;
        margin: 0;
        padding: 0 1.5rem;
        box-sizing: border-box;
        width: max-content;
        min-width: 100%;
    }

    .timeline-item {
        display: grid;
        grid-row: span 3;
        grid-template-rows: subgrid;
    }

    .timeline-mid {
        grid-row: 2;
        position: relative;
        height: 3rem;
        display: flex;
        align-items: center;
    }

    .timeline-mid::before {
        content: "";
        position: absolute;
        left: 0;
        right: -1.5rem;
        top: 50%;
        height: 3px;
        transform: translateY(-50%);
        background-color: var(--ink);
    }

    .timeline-item:last-child .timeline-mid::before {
        right: 0;
    }

    .timeline-mid::after {
        content: "";
        position: absolute;
        left: 1.5rem;
        width: 2px;
        height: 1.5rem;
        transform: translateX(-50%);
        background-color: var(--ink);
    }

    .is-top .timeline-mid::after    { bottom: 50%; }
    .is-bottom .timeline-mid::after { top: 50%; }

    .timeline-dot {
        position: relative;
        z-index: 1;
        margin-left: 1.5rem;
        transform: translateX(-50%);
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background-color: var(--cta);
        border: 2px solid var(--ink);
        box-shadow: 0 0 0 3px var(--white);
    }

    .badge-yellow {
        background-color: var(--t-yellow);
        color: var(--ink);
        border: 1.5px solid var(--ink);
        border-radius: var(--radius-full);
        font-weight: 700;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        padding: 2px 10px;
    }

    .timeline-card {
        padding: 20px;
        background-color: var(--white);
        border: var(--stroke);
        border-radius: var(--radius-s);
        box-shadow: var(--die), 0 4px 0 1px rgb(0 0 0 / 0.35);
        transition: transform 160ms var(--spring), box-shadow 160ms var(--ease);
    }

    .is-top .timeline-card {
        grid-row: 1;
        align-self: end;
    }

    .is-bottom .timeline-card {
        grid-row: 3;
        align-self: start;
    }

    .timeline-item:hover .timeline-card {
        transform: translateY(-4px) rotate(-1deg);
        box-shadow: var(--die), var(--lift);
    }

    .is-bottom:hover .timeline-card {
        transform: translateY(4px) rotate(1deg);
    }

    .is-current .timeline-card {
        border-color: var(--cta);
        border-width: 2.5px;
    }

    .is-current .timeline-dot {
        background-color: var(--green);
        animation: ping 2s infinite;
    }

    .timeline-item-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--ink);
    }

    .timeline-item-desc {
        line-height: 1.45;
        color: var(--ink-2);
    }

    /* Mobile Timeline */
    @media (max-width: 767px) {
        .timeline {
            display: flex;
            flex-direction: column;
            width: auto;
            padding: 0;
            gap: 1.25rem;
        }

        .timeline-item { display: block; }
        .timeline-mid { display: none; }
        .timeline-item:hover .timeline-card,
        .is-bottom:hover .timeline-card { transform: none; }
    }
</style>

<script>
    const scroller = document.querySelector<HTMLElement>(".timeline-scroll");

    if (scroller) {
        let lastWheel = 0;

        scroller.addEventListener(
            "wheel",
            (e) => {
                if (scroller.scrollWidth <= scroller.clientWidth) return;
                if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;

                const now = Date.now();
                const idle = now - lastWheel > 400;
                lastWheel = now;

                const atStart = scroller.scrollLeft <= 0;
                const atEnd =
                    scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 1;
                const pushingPastEdge =
                    (e.deltaY < 0 && atStart) || (e.deltaY > 0 && atEnd);

                if (pushingPastEdge && idle) return;

                e.preventDefault();
                scroller.scrollLeft += e.deltaY;
            },
            { passive: false }
        );
    }
</script>
