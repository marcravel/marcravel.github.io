---
import BaseLayout from "../../layouts/BaseLayout.astro";
import aboutContent from "../../data/about.json";

export interface Props {
    lang: "en" | "fr" | "tr";
}
const { lang } = Astro.props;

// Toggle for Turkish Scholarship badge
const showScholarship = true;

const courseLinks = {
    course1:
        "https://www.btkakademi.gov.tr/portal/certificate/validate?certificateId=XV1hBaa9oN",
    course2: "https://www.coursera.org/verify/HC796LSS9QRM",
    course3:
        "https://api.badgr.io/public/assertions/JkBrRzqfSDaWcRq_v04m2w?identity__email=marc.anjaniaina%40gmail.com",
    course4: "https://coursera.org/verify/XQCPABZTSJMW",
};

const texts = {
    en: {
        title: "About - Marc",
        description:
            "Learn about Marc, a final-year Electrical-Electronics Engineering student focused on embedded firmware, electronics, PCB design, and control.",
        h1: "About Me",
        profSummary: "Professional Summary",
        techMatrix: "Technical Skills Matrix",
        hwEmb: "Embedded Firmware",
        softAi: "Control",
        toolsMulti: "Tools & Multimedia",
        supportingSoftware: "Supporting Software",
        supportingSoftwareDesc: "Familiar with ML fundamentals and OpenCV",
        languages: "Languages",
        eduHonors: "Education",
        experience: "Experiences",
        courses: "Courses",
        certTitle: "View Certificate",
        community: "Community Involvement",
    },
    fr: {
        title: "À propos - Marc",
        description:
            "Découvrez Marc, étudiant en dernière année de génie électrique et électronique, spécialisé en firmware embarqué, électronique, conception de circuits imprimés et contrôle.",
        h1: "À propos de moi",
        profSummary: "Résumé Professionnel",
        techMatrix: "Matrice de Compétences Techniques",
        hwEmb: "Firmware embarqué",
        softAi: "Contrôle",
        toolsMulti: "Outils & Multimédia",
        supportingSoftware: "Logiciels complémentaires",
        supportingSoftwareDesc: "Connaissances des fondamentaux du ML et d'OpenCV",
        languages: "Langues",
        eduHonors: "Éducation",
        experience: "Expériences",
        courses: "Cours",
        certTitle: "Voir le certificat",
        community: "Engagement Communautaire",
    },
    tr: {
        title: "Hakkımda - Marc",
        description:
            "Gömülü firmware, elektronik, PCB tasarımı ve kontrole odaklanan son sınıf Elektrik-Elektronik Mühendisliği öğrencisi Marc hakkında bilgi edinin.",
        h1: "Hakkımda",
        profSummary: "Profesyonel Özet",
        techMatrix: "Teknik Yetenek Matrisi",
        hwEmb: "Gömülü Firmware",
        softAi: "Kontrol",
        toolsMulti: "Araçlar ve Multimedya",
        supportingSoftware: "Destekleyici Yazılım",
        supportingSoftwareDesc: "ML temelleri ve OpenCV hakkında bilgi sahibi",
        languages: "Diller",
        eduHonors: "Eğitim",
        experience: "Deneyimler",
        courses: "Kurslar",
        certTitle: "Sertifikayı Görüntüle",
        community: "Topluluk Katılımı",
    },
};

const t = { ...texts[lang], ...aboutContent[lang] };
---

<BaseLayout title={t.title} description={t.description}>
    <section class="section">
        <div class="container animate-fade-up">
            <h1 class="section-title"><span>{t.h1}</span></h1>

            <div class="grid grid-cols-1 md-grid-cols-2 lg-grid-cols-2 gap-5">
                <!-- Left Column: Bio & Skills -->
                <div>
                    <!-- Professional Summary -->
                    <div class="glass p-4 p-md-5 mb-5">
                        <h3
                            class="mb-3"
                            style="color: var(--color-accent-1); font-size: 1.5rem;"
                        >
                            {t.profSummary}
                        </h3>
                        <p
                            class="lead"
                            style="color: var(--color-text-secondary); font-size: 1.1rem; line-height: 1.8;"
                        >
                            {t.bioText}
                        </p>
                    </div>

                    <!-- Technical Skills Matrix -->
                    <div class="glass p-4 p-md-5 mb-5">
                        <h3
                            class="mb-4"
                            style="color: var(--color-accent-2); font-size: 1.5rem;"
                        >
                            {t.techMatrix}
                        </h3>

                        <div class="mb-4">
                            <h5
                                class="text-uppercase mb-3 small fw-bold"
                                style="color: var(--color-text-secondary); letter-spacing: 1px;"
                            >
                                {t.hwEmb}
                            </h5>
                            <div class="d-flex flex-wrap gap-2">
                                <span class="badge px-3 py-2" set:html={t.skillItems.embedded[0]}></span>
                                <span class="badge px-3 py-2" set:html={t.skillItems.embedded[1]}></span>
                                <span class="badge px-3 py-2" set:html={t.skillItems.embedded[2]}></span>
                                <span class="badge px-3 py-2" set:html={t.skillItems.embedded[3]}></span>
                                <span class="badge px-3 py-2" set:html={t.skillItems.embedded[4]}></span>
                                <span class="badge px-3 py-2" set:html={t.skillItems.embedded[5]}></span>
                                <span class="badge px-3 py-2" set:html={t.skillItems.embedded[6]}></span>
                                <span class="badge px-3 py-2" set:html={t.skillItems.embedded[7]}></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <h5
                                class="text-uppercase mb-3 small fw-bold"
                                style="color: var(--color-text-secondary); letter-spacing: 1px;"
                            >
                                {t.softAi}
                            </h5>
                            <div class="d-flex flex-wrap gap-2">
                                <span class="badge px-3 py-2" style="border-color: rgba(59, 130, 246, 0.5); color: #60a5fa;" set:html={t.skillItems.control[0]}></span>
                                <span class="badge px-3 py-2" style="border-color: rgba(59, 130, 246, 0.5); color: #60a5fa;" set:html={t.skillItems.control[1]}></span>
                                <span class="badge px-3 py-2" style="border-color: rgba(59, 130, 246, 0.5); color: #60a5fa;" set:html={t.skillItems.control[2]}></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <h5
                                class="text-uppercase mb-3 small fw-bold"
                                style="color: var(--color-text-secondary); letter-spacing: 1px;"
                            >
                                {t.toolsMulti}
                            </h5>
                            <div class="d-flex flex-wrap gap-2">
                                <span class="badge px-3 py-2" style="border-color: rgba(139, 92, 246, 0.5); color: #c084fc;" set:html={t.skillItems.tools[0]}></span>
                                <span class="badge px-3 py-2" style="border-color: rgba(139, 92, 246, 0.5); color: #c084fc;" set:html={t.skillItems.tools[1]}></span>
                                <span class="badge px-3 py-2" style="border-color: rgba(139, 92, 246, 0.5); color: #c084fc;" set:html={t.skillItems.tools[2]}></span>
                                <span class="badge px-3 py-2" style="border-color: rgba(139, 92, 246, 0.5); color: #c084fc;" set:html={t.skillItems.tools[3]}></span>
                                <span class="badge px-3 py-2" style="border-color: rgba(139, 92, 246, 0.5); color: #c084fc;" set:html={t.skillItems.tools[4]}></span>
                                <span class="badge px-3 py-2" style="border-color: rgba(139, 92, 246, 0.5); color: #c084fc;" set:html={t.skillItems.tools[5]}></span>
                                <span class="badge px-3 py-2" style="border-color: rgba(139, 92, 246, 0.5); color: #c084fc;" set:html={t.skillItems.tools[6]}></span>
                            </div>
                        </div>

                        <div>
                            <h5
                                class="text-uppercase mb-3 small fw-bold"
                                style="color: var(--color-text-secondary); letter-spacing: 1px;"
                            >
                                {t.supportingSoftware}
                            </h5>
                            <p class="small text-muted mb-0">
                                {t.supportingSoftwareDesc}
                            </p>
                        </div>
                    </div>

                    <!-- Languages -->
                    <div class="glass p-4 p-md-5 mb-5">
                        <h3
                            class="mb-4"
                            style="color: var(--color-accent-1); font-size: 1.5rem;"
                        >
                            {t.languages}
                        </h3>
                        <div class="d-flex flex-column gap-3">
                            <div
                                class="d-flex align-items-center justify-content-between"
                            >
                                <strong
                                    style="color: var(--color-text-primary);"
                                    >{t.spokenLanguages[0].name}</strong
                                >
                                <div
                                    style="flex-grow: 1; border-bottom: 1px dashed rgba(255,255,255,0.1); margin: 0 1rem;"
                                >
                                </div>
                                <span
                                    style="color: var(--color-text-secondary);"
                                    >{t.spokenLanguages[0].level}</span
                                >
                            </div>
                            <div
                                class="d-flex align-items-center justify-content-between"
                            >
                                <strong
                                    style="color: var(--color-text-primary);"
                                    >{t.spokenLanguages[1].name}</strong
                                >
                                <div
                                    style="flex-grow: 1; border-bottom: 1px dashed rgba(255,255,255,0.1); margin: 0 1rem;"
                                >
                                </div>
                                <span
                                    style="color: var(--color-text-secondary);"
                                    >{t.spokenLanguages[1].level}</span
                                >
                            </div>
                            <div
                                class="d-flex align-items-center justify-content-between"
                            >
                                <strong
                                    style="color: var(--color-text-primary);"
                                    >{t.spokenLanguages[2].name}</strong
                                >
                                <div
                                    style="flex-grow: 1; border-bottom: 1px dashed rgba(255,255,255,0.1); margin: 0 1rem;"
                                >
                                </div>
                                <span
                                    style="color: var(--color-text-secondary);"
                                    >{t.spokenLanguages[2].level}</span
                                >
                            </div>
                            <div
                                class="d-flex align-items-center justify-content-between"
                            >
                                <strong
                                    style="color: var(--color-text-primary);"
                                    >{t.spokenLanguages[3].name}</strong
                                >
                                <div
                                    style="flex-grow: 1; border-bottom: 1px dashed rgba(255,255,255,0.1); margin: 0 1rem;"
                                >
                                </div>
                                <span
                                    style="color: var(--color-text-secondary);"
                                    >{t.spokenLanguages[3].level}</span
                                >
                            </div>
                            <div
                                class="d-flex align-items-center justify-content-between"
                            >
                                <strong
                                    style="color: var(--color-text-primary);"
                                    >{t.spokenLanguages[4].name}</strong
                                >
                                <div
                                    style="flex-grow: 1; border-bottom: 1px dashed rgba(255,255,255,0.1); margin: 0 1rem;"
                                >
                                </div>
                                <span
                                    style="color: var(--color-text-secondary);"
                                    >{t.spokenLanguages[4].level}</span
                                >
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Education & Experience -->
                <div>
                    <h3
                        class="mb-4"
                        style="color: var(--color-accent-2); font-size: 1.5rem;"
                    >
                        {t.eduHonors}
                    </h3>{t.educationEntries.map((entry, index) => (
                            <>                             <Fragment set:html={`<!-- Education Card ${entry.cardLabel} -->`} />
                            <div class="glass p-4 mb-4 edu-card">
                                <h5
                                    class="fw-bold mb-2"
                                    style="color: var(--color-text-primary);"
                                >
                                    {entry.title}
                                </h5>
                                <p
                                    class="mb-2 small fw-bold"
                                    style="color: var(--color-accent-1);"
                                >
                                    {entry.year}
                                </p>
                                <p
                                    class="small mb-3"
                                    style="color: var(--color-text-secondary);"
                                >
                                    {entry.loc}
                                </p>
                                {entry.badge && (
                                    entry.badgeStyle === "scholarship" ? (
                                    showScholarship && (
                                        <div class="mt-2">
                                            <span class="badge px-3 py-2" style="background: rgba(59, 130, 246, 0.1); color: #60a5fa; border-color: rgba(59, 130, 246, 0.3);">{entry.badge}</span>
                                        </div>
                                    )
                                    ) : (
                                    <div class="mt-2">
                                        <span class="badge px-3 py-2" style="background: rgba(255, 255, 255, 0.05); border-color: rgba(255, 255, 255, 0.1);">{entry.badge}</span>
                                        </div>
                                    )
                                )}
                                </div></>
                        ))}

                    <h3
                        class="mb-4 mt-5"
                        style="color: var(--color-accent-1); font-size: 1.5rem;"
                    >
                        {t.experience}
                    </h3>{t.experienceEntries.map((entry) => (
                            <> <Fragment set:html={`<!-- Experience Card ${entry.cardLabel} -->`} />
                            <div class="glass p-4 mb-5 edu-card">
                                <h5
                                    class="fw-bold mb-2"
                                    style="color: var(--color-text-primary);"
                                >
                                    {entry.title}
                                </h5>
                                <p
                                    class="mb-2 small fw-bold"
                                    style="color: var(--color-accent-2);"
                                >
                                    {entry.year}
                                </p>
                                <p
                                    class="small mb-4"
                                    style="color: var(--color-text-secondary);"
                                >
                                    {entry.loc}
                                </p>
                                <ul
                                    class="small mb-0 ps-3"
                                    style="color: var(--color-text-secondary); line-height: 1.6;"
                                >
                                    <li class:list={["mb-2", !entry.li2 && !entry.li3 && "mb-0"]}>{entry.li1}</li>
                                    {entry.li2 && <li class="mb-2">{entry.li2}</li>}
                                    {entry.li3 && <li>{entry.li3}</li>}
                                </ul>
                            </div></>
                        ))}

                    <h3
                        class="mb-4 mt-5"
                        style="color: var(--color-accent-2); font-size: 1.5rem;"
                    >
                        {t.courses}
                    </h3>

                    <!-- Courses card 1-->
                    <a
                        href={courseLinks.course1}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-decoration-none course-link d-block"
                    >
                        <div class="glass p-4 mb-4 edu-card">
                            <div class="cert-overlay">
                                <span class="cert-btn">{t.certTitle}</span>
                            </div>
                            <h5
                                class="fw-bold mb-2 course-title"
                                style="color: var(--color-text-primary);"
                            >
                                {t.courseEntries[0].title}
                            </h5>
                            <p
                                class="mb-2 small fw-bold"
                                style="color: var(--color-accent-1);"
                            >
                                {t.courseEntries[0].year}
                            </p>
                            <p
                                class="small mb-4"
                                style="color: var(--color-text-secondary);"
                            >
                                {t.courseEntries[0].loc}
                            </p>
                            <ul
                                class="small mb-0 ps-3"
                                style="color: var(--color-text-secondary); line-height: 1.6;"
                            >
                                <li class="mb-2">{t.courseEntries[0].li1}</li>
                                <li>{t.courseEntries[0].li2}</li>
                            </ul>
                        </div>
                    </a>

                    <!-- Courses card 2-->
                    <a
                        href={courseLinks.course2}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-decoration-none course-link d-block"
                    >
                        <div class="glass p-4 mb-4 edu-card">
                            <div class="cert-overlay">
                                <span class="cert-btn">{t.certTitle}</span>
                            </div>
                            <h5
                                class="fw-bold mb-2 course-title"
                                style="color: var(--color-text-primary);"
                            >
                                {t.courseEntries[1].title}
                            </h5>
                            <p
                                class="mb-2 small fw-bold"
                                style="color: var(--color-accent-1);"
                            >
                                {t.courseEntries[1].year}
                            </p>
                            <p
                                class="small mb-4"
                                style="color: var(--color-text-secondary);"
                            >
                                {t.courseEntries[1].loc}
                            </p>
                            <ul
                                class="small mb-0 ps-3"
                                style="color: var(--color-text-secondary); line-height: 1.6;"
                            >
                                <li class="mb-2">{t.courseEntries[1].li1}</li>
                                <li class="mb-2">{t.courseEntries[1].li2}</li>
                                <li>{t.courseEntries[1].li3}</li>
                            </ul>
                        </div>
                    </a>

                    <!-- Courses card 3-->
                    <a
                        href={courseLinks.course3}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-decoration-none course-link d-block"
                    >
                        <div class="glass p-4 mb-4 edu-card">
                            <div class="cert-overlay">
                                <span class="cert-btn">{t.certTitle}</span>
                            </div>
                            <h5
                                class="fw-bold mb-2 course-title"
                                style="color: var(--color-text-primary);"
                            >
                                {t.courseEntries[2].title}
                            </h5>
                            <p
                                class="mb-2 small fw-bold"
                                style="color: var(--color-accent-1);"
                            >
                                {t.courseEntries[2].year}
                            </p>
                            <p
                                class="small mb-4"
                                style="color: var(--color-text-secondary);"
                            >
                                {t.courseEntries[2].loc}
                            </p>
                            <ul
                                class="small mb-0 ps-3"
                                style="color: var(--color-text-secondary); line-height: 1.6;"
                            >
                                <li class="mb-2">{t.courseEntries[2].li1}</li>
                            </ul>
                        </div>
                    </a>

                    <!-- Courses card 4-->
                    <a
                        href={courseLinks.course4}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-decoration-none course-link d-block"
                    >
                        <div class="glass p-4 mb-5 edu-card">
                            <div class="cert-overlay">
                                <span class="cert-btn">{t.certTitle}</span>
                            </div>
                            <h5
                                class="fw-bold mb-2 course-title"
                                style="color: var(--color-text-primary);"
                            >
                                {t.courseEntries[3].title}
                            </h5>
                            <p
                                class="mb-2 small fw-bold"
                                style="color: var(--color-accent-1);"
                            >
                                {t.courseEntries[3].year}
                            </p>
                            <p
                                class="small mb-4"
                                style="color: var(--color-text-secondary);"
                            >
                                {t.courseEntries[3].loc}
                            </p>
                            <ul
                                class="small mb-0 ps-3"
                                style="color: var(--color-text-secondary); line-height: 1.6;"
                            >
                                <li class="mb-2">{t.courseEntries[3].li1}</li>
                            </ul>
                        </div>
                    </a>

                    <h3
                        class="mb-4 mt-5"
                        style="color: var(--color-accent-1); font-size: 1.5rem;"
                    >
                        {t.community}
                    </h3>

                    <!-- Community card 1-->
                    <div class="glass p-4 mb-4 edu-card">
                        <h5
                            class="fw-bold mb-2"
                            style="color: var(--color-text-primary);"
                        >
                            {t.communityEntries[0].title}
                        </h5>
                        <p
                            class="mb-2 small fw-bold"
                            style="color: var(--color-accent-2);"
                        >
                            {t.communityEntries[0].year}
                        </p>
                        <p
                            class="small mb-4"
                            style="color: var(--color-text-secondary);"
                        >
                            {t.communityEntries[0].loc}
                        </p>
                        <ul
                            class="small mb-0 ps-3"
                            style="color: var(--color-text-secondary); line-height: 1.6;"
                        >
                            <li class="mb-2">{t.communityEntries[0].li1}</li>
                            <li class="mb-2">{t.communityEntries[0].li2}</li>
                            <li>{t.communityEntries[0].li3}</li>
                        </ul>
                    </div>

                    <!-- Community card 2-->
                    <div class="glass p-4 mb-4 edu-card">
                        <h5
                            class="fw-bold mb-2"
                            style="color: var(--color-text-primary);"
                        >
                            {t.communityEntries[1].title}
                        </h5>
                        <p
                            class="mb-2 small fw-bold"
                            style="color: var(--color-accent-2);"
                        >
                            {t.communityEntries[1].year}
                        </p>
                        <p
                            class="small mb-4"
                            style="color: var(--color-text-secondary);"
                        >
                            {t.communityEntries[1].loc}
                        </p>
                        <ul
                            class="small mb-0 ps-3"
                            style="color: var(--color-text-secondary); line-height: 1.6;"
                        >
                            <li class="mb-2">{t.communityEntries[1].li1}</li>
                            <li>{t.communityEntries[1].li2}</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<style is:global>
    /* Hover Effects for Cards matching ProjectCards */
    .edu-card {
        transition:
            transform 0.3s ease,
            border-color 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .edu-card:hover {
        transform: translateY(-5px);
        border-color: var(--color-accent-1);
    }

    .ps-3 {
        padding-left: 1rem;
    }

    .course-link {
        color: inherit;
    }

    .cert-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(10, 10, 10, 0.7);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: all 0.3s ease;
        z-index: 10;
    }

    .cert-btn {
        background: var(--color-accent-1);
        color: #fff;
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.95rem;
        transform: translateY(15px);
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }

    .course-link:hover .cert-overlay {
        opacity: 1;
    }

    .course-link:hover .cert-btn {
        transform: translateY(0);
    }
</style>
